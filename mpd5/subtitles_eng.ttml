<?xml version="1.0" encoding="utf-8"?>
<tt ttp:contentProfiles="http://www.w3.org/ns/ttml/profile/imsc1.1/text" xmlns="http://www.w3.org/ns/ttml" xmlns:nttm="http://www.netflix.com/ns/ttml#metadata" xmlns:tt="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:xml="http://www.w3.org/XML/1998/namespace" ttp:tickRate="10000000" ttp:timeBase="media" xml:lang="en">
<head>
<metadata nttm:schemaVersion="0" nttm:textType="CC" nttm:uuid="d75fd77a-2ad2-4f6d-8bcb-8998556253ac"/>
<styling>
<initial tts:backgroundColor="transparent" tts:color="white" tts:displayAlign="after" tts:extent="80.000% 80.000%" tts:opacity="1.000" tts:origin="10.000% 10.000%" tts:showBackground="whenActive" tts:textAlign="center" tts:textOutline="black 0.300rh" tts:writingMode="lrtb"/>
<style xml:id="style1" tts:fontWeight="normal"/>
<style xml:id="style2" tts:fontStyle="italic" tts:fontWeight="normal"/>
</styling>
<layout>
<region xml:id="region0" tts:backgroundColor="transparent" tts:displayAlign="after" tts:extent="80.000% 80.000%" tts:origin="10.000% 10.000%"/>
</layout>
</head>
<body>
<div>
<p xml:id="subtitle1" begin="78333334t" end="100000000t" region="region0"><span style="style1">[Appa grunting softly]</span></p>
<p xml:id="subtitle2" begin="300000000t" end="322083334t" region="region0"><span style="style1">I'm such an idiot, Appa.</span></p>
<p xml:id="subtitle3" begin="322916667t" end="343333334t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle4" begin="344166667t" end="365416667t" region="region0"><span style="style1">Why was I such a jerk to her?</span></p>
<p xml:id="subtitle5" begin="371250000t" end="385416667t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle6" begin="386250000t" end="411250000t" region="region0"><span style="style1">I told her I didn't need her.</span></p>
<p xml:id="subtitle7" begin="412083334t" end="427500000t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle8" begin="428333334t" end="446250000t" region="region0"><span style="style1">Practically yelled it at her.</span></p>
<p xml:id="subtitle9" begin="447083334t" end="457500000t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle10" begin="470416667t" end="486666667t" region="region0"><span style="style1">Why'd I do that?</span></p>
<p xml:id="subtitle11" begin="487500000t" end="505833334t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle12" begin="524166667t" end="539583334t" region="region0"><span style="style1">Words made of air.</span></p>
<p xml:id="subtitle13" begin="555416667t" end="567500000t" region="region0"><span style="style1">Airbend.</span></p>
<p xml:id="subtitle14" begin="592083334t" end="612083334t" region="region0"><span style="style1">Why not words bend?</span></p>
<p xml:id="subtitle15" begin="612916667t" end="632083334t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle16" begin="647916667t" end="675833334t" region="region0"><span style="style1">Wait a minute. There's a way out of this.</span></p>
<p xml:id="subtitle17" begin="676666667t" end="696666667t" region="region0"><span style="style1">I just have to say…</span></p>
<p xml:id="subtitle18" begin="724583334t" end="736666667t" region="region0"><span style="style1">I'm sorry.</span></p>
<p xml:id="subtitle19" begin="741666667t" end="756250000t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle20" begin="782500000t" end="795000000t" region="region0"><span style="style1">Is Katara…</span></p>
<p xml:id="subtitle21" begin="805416667t" end="815416667t" region="region0"><span style="style1">[Sokka] Uh…</span></p>
<p xml:id="subtitle22" begin="820416667t" end="869583334t" region="region0"><span style="style1">Right. Um, does the bluebell have</span><br/><span style="style1">a cheese dumpling</span></p>
<p xml:id="subtitle23" begin="870416667t" end="885833334t" region="region0"><span style="style1">that laments the elbow leech?</span></p>
<p xml:id="subtitle24" begin="886666667t" end="912916667t" region="region0"><span style="style1">It's okay. The Dai Li</span><br/><span style="style1">that was spying on us is gone now.</span></p>
<p xml:id="subtitle25" begin="913750000t" end="932083334t" region="region0"><span style="style1">-No one's within earshot.</span><br/><span style="style1">-What was that?</span></p>
<p xml:id="subtitle26" begin="932916667t" end="957916667t" region="region0"><span style="style1">-I was using the code words.</span><br/><span style="style1">-Didn't you get the updated list?</span></p>
<p xml:id="subtitle27" begin="958750000t" end="977083334t" region="region0"><span style="style1">You updated the code word list again?</span></p>
<p xml:id="subtitle28" begin="977916667t" end="1007916667t" region="region0"><span style="style1">Yes! 'Cause the Dai Li have been</span><br/><span style="style1">crawling all over the villa,</span></p>
<p xml:id="subtitle29" begin="1008750000t" end="1035416667t" region="region0"><span style="style1">trying to catch us talking about stuff,</span><br/><span style="style1">and they might break the code!</span></p>
<p xml:id="subtitle30" begin="1036250000t" end="1051666667t" region="region0"><span style="style1">No one can break the code.</span></p>
<p xml:id="subtitle31" begin="1052500000t" end="1070416667t" region="region0"><span style="style1">I know the code. I can't even break it.</span></p>
<p xml:id="subtitle32" begin="1071250000t" end="1095416667t" region="region0"><span style="style1">Guys, it doesn't matter.</span><br/><span style="style1">Momo ate the new list anyway.</span></p>
<p xml:id="subtitle33" begin="1096250000t" end="1118750000t" region="region0"><span style="style1">He ate it for security purposes.</span></p>
<p xml:id="subtitle34" begin="1119583334t" end="1157916667t" region="region0"><span style="style1">-I was trying to ask if Katara's here.</span><br/><span style="style1">-She left early to meet with General Sung.</span></p>
<p xml:id="subtitle35" begin="1158750000t" end="1190000000t" region="region0"><span style="style1">She's very positive in the jing</span><br/><span style="style1">about this new mission.</span></p>
<p xml:id="subtitle36" begin="1190833334t" end="1212500000t" region="region0"><span style="style1">I think she felt bad</span><br/><span style="style1">about losing track of Joo Dee.</span></p>
<p xml:id="subtitle37" begin="1213333334t" end="1230833334t" region="region0"><span style="style1">Joo Dee's a master spy.</span><br/><span style="style1">Who could blame her?</span></p>
<p xml:id="subtitle38" begin="1231666667t" end="1272500000t" region="region0"><span style="style1">Yeah, it's, uh, totally a good thing</span><br/><span style="style1">that we were all super nice to her</span></p>
<p xml:id="subtitle39" begin="1273333334t" end="1312500000t" region="region0"><span style="style1">and, uh, thanked her</span><br/><span style="style1">for all of her hard work and dedication.</span></p>
<p xml:id="subtitle40" begin="1313333334t" end="1327500000t" region="region0"><span style="style1">Okay, I did not do that at all.</span></p>
<p xml:id="subtitle41" begin="1328333334t" end="1344166667t" region="region0"><span style="style1">-Was I supposed to do that?</span><br/><span style="style1">-No.</span></p>
<p xml:id="subtitle42" begin="1352500000t" end="1364166667t" region="region0"><span style="style1">What about Professor Zei?</span></p>
<p xml:id="subtitle43" begin="1365000000t" end="1389583334t" region="region0"><span style="style1">Does he have more information</span><br/><span style="style1">about the Spirit Library?</span></p>
<p xml:id="subtitle44" begin="1390416667t" end="1417916667t" region="region0"><span style="style1">He may have a scroll</span><br/><span style="style1">that says where the entrance used to be.</span></p>
<p xml:id="subtitle45" begin="1418750000t" end="1457083334t" region="region0"><span style="style1">We're sure that something in this library</span><br/><span style="style1">tells us when the comet is coming?</span></p>
<p xml:id="subtitle46" begin="1457916667t" end="1468333334t" region="region0"><span style="style1">[Sokka] Legend has it,</span></p>
<p xml:id="subtitle47" begin="1469166667t" end="1503333334t" region="region0"><span style="style1">it has the greatest repository</span><br/><span style="style1">of knowledge in the universe.</span></p>
<p xml:id="subtitle48" begin="1516250000t" end="1527916667t" region="region0"><span style="style1">So maybe.</span></p>
<p xml:id="subtitle49" begin="1538750000t" end="1567916667t" region="region0"><span style="style1">Right now, the best plan is</span><br/><span style="style1">to get the information for the Earth King.</span></p>
<p xml:id="subtitle50" begin="1568750000t" end="1589583334t" region="region0"><span style="style1">Anyway, I better get going.</span></p>
<p xml:id="subtitle51" begin="1590416667t" end="1608750000t" region="region0"><span style="style1">I gotta keep up appearances</span><br/><span style="style1">with Long Feng.</span></p>
<p xml:id="subtitle52" begin="1609583334t" end="1635833334t" region="region0"><span style="style1">Why keep up the act?</span><br/><span style="style1">He knows you know he's lying, right?</span></p>
<p xml:id="subtitle53" begin="1645000000t" end="1700416667t" region="region0"><span style="style1">Sure, but if I keep doing what he asks,</span><br/><span style="style1">he'll think I'm scared</span></p>
<p xml:id="subtitle54" begin="1701250000t" end="1739166667t" region="region0"><span style="style1">because I know that he knows</span><br/><span style="style1">that I know he knows.</span></p>
<p xml:id="subtitle55" begin="1740000000t" end="1762083334t" region="region0"><span style="style1">And that's exactly</span><br/><span style="style1">what I want him to think.</span></p>
<p xml:id="subtitle56" begin="1776666667t" end="1794166667t" region="region0"><span style="style1">Wait, was that the new code?</span></p>
<p xml:id="subtitle57" begin="1799166667t" end="1807500000t" region="region0"><span style="style1">No.</span></p>
<p xml:id="subtitle58" begin="1808333334t" end="1817500000t" region="region0"><span style="style1">[door opens]</span></p>
<p xml:id="subtitle59" begin="1818333334t" end="1838333334t" region="region0"><span style="style1">[dramatic music playing]</span></p>
<p xml:id="subtitle60" begin="1927083334t" end="1947083334t" region="region0"><span style="style1">[mysterious music playing]</span></p>
<p xml:id="subtitle61" begin="1986250000t" end="1996250000t" region="region0"><span style="style1">[music fades]</span></p>
<p xml:id="subtitle62" begin="1997083334t" end="2017083334t" region="region0"><span style="style1">[indistinct chatter]</span></p>
<p xml:id="subtitle63" begin="2146250000t" end="2156250000t" region="region0"><span style="style1">[Sung] Were you followed?</span></p>
<p xml:id="subtitle64" begin="2167916667t" end="2177500000t" region="region0"><span style="style1">[Katara] No.</span></p>
<p xml:id="subtitle65" begin="2184583334t" end="2196666667t" region="region0"><span style="style1">Any luck with our friend?</span></p>
<p xml:id="subtitle66" begin="2197500000t" end="2222500000t" region="region0"><span style="style1">[Sung] I've been unable</span><br/><span style="style1">to locate your mechanist.</span></p>
<p xml:id="subtitle67" begin="2227500000t" end="2262083334t" region="region0"><span style="style1">Do you have a plan to tell the Earth King</span><br/><span style="style1">about the comet without Sai?</span></p>
<p xml:id="subtitle68" begin="2262916667t" end="2277500000t" region="region0"><span style="style1">It's in the works.</span></p>
<p xml:id="subtitle69" begin="2283333334t" end="2299583334t" region="region0"><span style="style1">And what about an attack strategy?</span></p>
<p xml:id="subtitle70" begin="2309166667t" end="2345000000t" region="region0"><span style="style1">The Avatar was the key to victory</span><br/><span style="style1">in the Northern Water Tribes.</span></p>
<p xml:id="subtitle71" begin="2353750000t" end="2378333334t" region="region0"><span style="style1">If we're going to take the war</span><br/><span style="style1">to the Fire Nation,</span></p>
<p xml:id="subtitle72" begin="2379166667t" end="2397500000t" region="region0"><span style="style1">we will need his power.</span></p>
<p xml:id="subtitle73" begin="2398333334t" end="2419166667t" region="region0"><span style="style1">Yeah, he's… he's working on that too.</span></p>
<p xml:id="subtitle74" begin="2447916667t" end="2467916667t" region="region0"><span style="style1">I know you and your friends</span><br/><span style="style1">have been through a lot,</span></p>
<p xml:id="subtitle75" begin="2468750000t" end="2504166667t" region="region0"><span style="style1">but you haven't faced</span><br/><span style="style1">someone like Long Feng before.</span></p>
<p xml:id="subtitle76" begin="2505000000t" end="2538333334t" region="region0"><span style="style1">A villain who deals in fear and secrets</span></p>
<p xml:id="subtitle77" begin="2543750000t" end="2575833334t" region="region0"><span style="style1">can cut the heart from his enemy</span><br/><span style="style1">without lifting a finger.</span></p>
<p xml:id="subtitle78" begin="2594583334t" end="2641666667t" region="region0"><span style="style1">I am rallying support from others</span><br/><span style="style1">to stand with Aang against Long Feng.</span></p>
<p xml:id="subtitle79" begin="2647916667t" end="2672916667t" region="region0"><span style="style1">Our lives will be on the line</span><br/><span style="style1">when he talks to the king,</span></p>
<p xml:id="subtitle80" begin="2673750000t" end="2688333334t" region="region0"><span style="style1">and yours may be too.</span></p>
<p xml:id="subtitle81" begin="2717916667t" end="2736666667t" region="region0"><span style="style1">I promise we will be ready.</span></p>
<p xml:id="subtitle82" begin="3002083334t" end="3017916667t" region="region0"><span style="style1">I wasn't followed.</span></p>
<p xml:id="subtitle83" begin="3050416667t" end="3063333334t" region="region0"><span style="style1">Please tell me you have it?</span></p>
<p xml:id="subtitle84" begin="3068750000t" end="3090000000t" region="region0"><span style="style1">Your dubiety is mithering, sir.</span></p>
<p xml:id="subtitle85" begin="3096666667t" end="3105833334t" region="region0"><span style="style1">[chuckles]</span></p>
<p xml:id="subtitle86" begin="3118333334t" end="3156250000t" region="region0"><span style="style1">Now, this is from personal letters</span><br/><span style="style1">of Yao Xiaobo, a legendary scholar</span></p>
<p xml:id="subtitle87" begin="3157083334t" end="3192083334t" region="region0"><span style="style1">renowned more for his taste for adventure</span><br/><span style="style1">than his research.</span></p>
<p xml:id="subtitle88" begin="3197083334t" end="3208750000t" region="region0"><span style="style1">A hero of mine.</span></p>
<p xml:id="subtitle89" begin="3217500000t" end="3255833334t" region="region0"><span style="style1">For generations,</span><br/><span style="style1">the library stood outside of Ba Sing Se,</span></p>
<p xml:id="subtitle90" begin="3256666667t" end="3297500000t" region="region0"><span style="style1">a resource for humans</span><br/><span style="style1">who sought knowledge for knowledge's sake.</span></p>
<p xml:id="subtitle91" begin="3298333334t" end="3307083334t" region="region0"><span style="style1">[Sokka] Hmm.</span></p>
<p xml:id="subtitle92" begin="3313333334t" end="3360833334t" region="region0"><span style="style1">To enter, one had only to offer a piece</span><br/><span style="style1">of their own knowledge to the collection.</span></p>
<p xml:id="subtitle93" begin="3361666667t" end="3391666667t" region="region0"><span style="style1">The librarian, Wan Shi Tong,</span></p>
<p xml:id="subtitle94" begin="3392500000t" end="3427083334t" region="region0"><span style="style1">oversaw the free exchange of wisdom,</span><br/><span style="style1">and harmony ruled.</span></p>
<p xml:id="subtitle95" begin="3435833334t" end="3462500000t" region="region0"><span style="style1">When the halls were sullied</span><br/><span style="style1">by warmongering humans,</span></p>
<p xml:id="subtitle96" begin="3463333334t" end="3488333334t" region="region0"><span style="style1">Wan Shi Tong rent existence itself</span></p>
<p xml:id="subtitle97" begin="3489166667t" end="3517500000t" region="region0"><span style="style1">and folded his library</span><br/><span style="style1">out of the human plane,</span></p>
<p xml:id="subtitle98" begin="3524166667t" end="3558333334t" region="region0"><span style="style1">leaving a spiritual scar on the land.</span></p>
<p xml:id="subtitle99" begin="3574583334t" end="3593750000t" region="region0"><span style="style1">-A spiritual scar?</span><br/><span style="style1">-[Zei] Mmm.</span></p>
<p xml:id="subtitle100" begin="3594583334t" end="3617916667t" region="region0"><span style="style1">I think we've seen one of these before.</span></p>
<p xml:id="subtitle101" begin="3618750000t" end="3654166667t" region="region0"><span style="style1">Seen? I thought it was a metaphor.</span><br/><span style="style1">It… it's real?</span></p>
<p xml:id="subtitle102" begin="3660833334t" end="3703333334t" region="region0"><span style="style1">[scoffs] It's a real metaphor, all right.</span><br/><span style="style1">We went through one into the Spirit World.</span></p>
<p xml:id="subtitle103" begin="3709166667t" end="3727916667t" region="region0"><span style="style1">-It's kind of terrible, actually.</span><br/><span style="style1">-[Zei] Huh.</span></p>
<p xml:id="subtitle104" begin="3737083334t" end="3764583334t" region="region0"><span style="style1">Well, I'd say this one must be somewhere</span><br/><span style="style1">in the Lower Ring.</span></p>
<p xml:id="subtitle105" begin="3765416667t" end="3795000000t" region="region0"><span style="style1">That's the area</span><br/><span style="style1">that has undergone the most growth.</span></p>
<p xml:id="subtitle106" begin="3795833334t" end="3822500000t" region="region0"><span style="style1">Well, at least now we have an idea</span><br/><span style="style1">of where we're headed.</span></p>
<p xml:id="subtitle107" begin="3845000000t" end="3855000000t" region="region0"><span style="style1">So,</span></p>
<p xml:id="subtitle108" begin="3862916667t" end="3887500000t" region="region0"><span style="style1">I can come if you find it.</span></p>
<p xml:id="subtitle109" begin="3888333334t" end="3901666667t" region="region0"><span style="style1">Yeah!</span></p>
<p xml:id="subtitle110" begin="3902500000t" end="3936250000t" region="region0"><span style="style1">I mean, without you,</span><br/><span style="style1">we wouldn't have any idea where to start.</span></p>
<p xml:id="subtitle111" begin="3973333334t" end="3988750000t" region="region0"><span style="style1">[Katar] So once we find the spirit scar,</span></p>
<p xml:id="subtitle112" begin="3989583334t" end="4022916667t" region="region0"><span style="style1">Aang should be able to meditate everyone</span><br/><span style="style1">into the Spirit World again.</span></p>
<p xml:id="subtitle113" begin="4023750000t" end="4052083334t" region="region0"><span style="style1">Okay, I'm sorry. What is a spirit scar?</span></p>
<p xml:id="subtitle114" begin="4062083334t" end="4085000000t" region="region0"><span style="style1">It's a place where the veil is thin</span><br/><span style="style1">between worlds.</span></p>
<p xml:id="subtitle115" begin="4090000000t" end="4120833334t" region="region0"><span style="style1">A place that feels a little haunted.</span></p>
<p xml:id="subtitle116" begin="4125833334t" end="4165416667t" region="region0"><span style="style1">It's like walking on thin ice,</span><br/><span style="style1">but the ice is… existence?</span></p>
<p xml:id="subtitle117" begin="4172083334t" end="4213333334t" region="region0"><span style="style1">So, haunted, between worlds, thin ice.</span></p>
<p xml:id="subtitle118" begin="4218333334t" end="4248333334t" region="region0"><span style="style1">Three things I've avoided my entire life.</span><br/><span style="style1">Can't wait!</span></p>
<p xml:id="subtitle119" begin="4249166667t" end="4287083334t" region="region0"><span style="style1">Tomorrow, we'll split up</span><br/><span style="style1">and search the Lower Ring till we find it.</span></p>
<p xml:id="subtitle120" begin="4295416667t" end="4339166667t" region="region0"><span style="style1">Be careful asking around.</span><br/><span style="style1">We can't trust anyone from Ba Sing Se.</span></p>
<p xml:id="subtitle121" begin="4340000000t" end="4351250000t" region="region0"><span style="style1">[Sokka] Hmm.</span></p>
<p xml:id="subtitle122" begin="4352083334t" end="4376250000t" region="region0"><span style="style1">What about people outside Ba Sing Se,</span><br/><span style="style1">like the refugees?</span></p>
<p xml:id="subtitle123" begin="4388333334t" end="4407916667t" region="region0"><span style="style1">I'm not sure how well</span><br/><span style="style1">they know the streets,</span></p>
<p xml:id="subtitle124" begin="4408750000t" end="4421250000t" region="region0"><span style="style1">but we can trust them.</span></p>
<p xml:id="subtitle125" begin="4436250000t" end="4455000000t" region="region0"><span style="style1">How did it go with General Sung?</span></p>
<p xml:id="subtitle126" begin="4460000000t" end="4475833334t" region="region0"><span style="style1">[Katara] She's nervous.</span></p>
<p xml:id="subtitle127" begin="4476666667t" end="4497916667t" region="region0"><span style="style1">She wants to know</span><br/><span style="style1">what your attack strategy is</span></p>
<p xml:id="subtitle128" begin="4498750000t" end="4513333334t" region="region0"><span style="style1">to fight the Fire Nation.</span></p>
<p xml:id="subtitle129" begin="4514166667t" end="4535416667t" region="region0"><span style="style1">[scoffs] Of course she does.</span></p>
<p xml:id="subtitle130" begin="4536250000t" end="4567916667t" region="region0"><span style="style1">-They always want a big attack plan.</span><br/><span style="style1">-They want the Avatar State.</span></p>
<p xml:id="subtitle131" begin="4573750000t" end="4602083334t" region="region0"><span style="style1">I know, but… I can't.</span></p>
<p xml:id="subtitle132" begin="4602916667t" end="4638333334t" region="region0"><span style="style1">Maybe the library will have another idea</span><br/><span style="style1">for how to fight back.</span></p>
<p xml:id="subtitle133" begin="4639166667t" end="4672083334t" region="region0"><span style="style1">Yeah. Yeah, I'm sure they'll have</span><br/><span style="style1">information about the Fire Nation there.</span></p>
<p xml:id="subtitle134" begin="4682083334t" end="4693333334t" region="region0"><span style="style1">Someone's coming!</span></p>
<p xml:id="subtitle135" begin="4698333334t" end="4714583334t" region="region0"><span style="style1">-[Toph clears throat]</span><br/><span style="style1">-[Sokka] Oh, uh…</span></p>
<p xml:id="subtitle136" begin="4715416667t" end="4726666667t" region="region0"><span style="style1">[knock on door]</span></p>
<p xml:id="subtitle137" begin="4732500000t" end="4741250000t" region="region0"><span style="style1">Toph Beifong?</span></p>
<p xml:id="subtitle138" begin="4742083334t" end="4760833334t" region="region0"><span style="style1">-Hide the map!</span><br/><span style="style1">-[Katara] Just give it to me.</span></p>
<p xml:id="subtitle139" begin="4761666667t" end="4787916667t" region="region0"><span style="style1">Let me guess. Proposal, right?</span></p>
<p xml:id="subtitle140" begin="4794166667t" end="4833750000t" region="region0"><span style="style1">Tall, business prodigy, handsome.</span></p>
<p xml:id="subtitle141" begin="4834583334t" end="4847916667t" region="region0"><span style="style1">As if that matters.</span></p>
<p xml:id="subtitle142" begin="4848750000t" end="4877083334t" region="region0"><span style="style1">Um… no.</span></p>
<p xml:id="subtitle143" begin="4909166667t" end="4930000000t" region="region0"><span style="style1">&quot;From the desk of Lady Beifong.&quot;</span></p>
<p xml:id="subtitle144" begin="4940000000t" end="4973333334t" region="region0"><span style="style1">&quot;Toph, I'll be arriving</span><br/><span style="style1">in Ba Sing Se tomorrow.&quot;</span></p>
<p xml:id="subtitle145" begin="4981250000t" end="5020416667t" region="region0"><span style="style1">&quot;The only purpose of my trip is</span><br/><span style="style1">to see you and make things right.&quot;</span></p>
<p xml:id="subtitle146" begin="5021250000t" end="5042500000t" region="region0"><span style="style1">&quot;Please, don't ignore me.&quot;</span></p>
<p xml:id="subtitle147" begin="5050416667t" end="5070416667t" region="region0"><span style="style1">&quot;With love, your mother.&quot;</span></p>
<p xml:id="subtitle148" begin="5071250000t" end="5091250000t" region="region0"><span style="style1">[mysterious music playing]</span></p>
<p xml:id="subtitle149" begin="5177083334t" end="5191666667t" region="region0"><span style="style1">[thunder rumbles]</span></p>
<p xml:id="subtitle150" begin="5220833334t" end="5255833334t" region="region0"><span style="style1">So you're the ones who captured</span><br/><span style="style1">General Tran of the Fire Nation.</span></p>
<p xml:id="subtitle151" begin="5264583334t" end="5283750000t" region="region0"><span style="style1">We're very grateful for your assistance.</span></p>
<p xml:id="subtitle152" begin="5291666667t" end="5332916667t" region="region0"><span style="style1">But I am a little surprised</span><br/><span style="style1">it's you who escorted this prisoner here.</span></p>
<p xml:id="subtitle153" begin="5337916667t" end="5384166667t" region="region0"><span style="style1">Suki determined, as our leader,</span><br/><span style="style1">she needed to maintain a vigilant watch.</span></p>
<p xml:id="subtitle154" begin="5389166667t" end="5422083334t" region="region0"><span style="style1">The Fire Nation are unpredictable,</span><br/><span style="style1">as you know.</span></p>
<p xml:id="subtitle155" begin="5438750000t" end="5464166667t" region="region0"><span style="style1">[Zei] I understand</span><br/><span style="style1">you want to see the Avatar.</span></p>
<p xml:id="subtitle156" begin="5465000000t" end="5523333334t" region="region0"><span style="style1">However, the Avatar and his companions are</span><br/><span style="style1">a little preoccupied with matters of state</span></p>
<p xml:id="subtitle157" begin="5524166667t" end="5538333334t" region="region0"><span style="style1">and won't be available.</span></p>
<p xml:id="subtitle158" begin="5539166667t" end="5552083334t" region="region0"><span style="style1">But in the meantime,</span></p>
<p xml:id="subtitle159" begin="5552916667t" end="5578750000t" region="region0"><span style="style1">we can provide housing</span><br/><span style="style1">in the city for you.</span></p>
<p xml:id="subtitle160" begin="5606666667t" end="5642083334t" region="region0"><span style="style1">Thank you, General Sung,</span><br/><span style="style1">for your hospitality.</span></p>
<p xml:id="subtitle161" begin="5647083334t" end="5663333334t" region="region0"><span style="style1">I do need to warn you.</span></p>
<p xml:id="subtitle162" begin="5664166667t" end="5691250000t" region="region0"><span style="style1">The city is its own nation-state.</span></p>
<p xml:id="subtitle163" begin="5696250000t" end="5730833334t" region="region0"><span style="style1">Quite independent</span><br/><span style="style1">from the military forces here at the Wall.</span></p>
<p xml:id="subtitle164" begin="5731666667t" end="5749583334t" region="region0"><span style="style1">I'm not sure I understand.</span></p>
<p xml:id="subtitle165" begin="5769583334t" end="5804166667t" region="region0"><span style="style1">They do not discuss the war</span><br/><span style="style1">inside the city.</span></p>
<p xml:id="subtitle166" begin="5825000000t" end="5860833334t" region="region0"><span style="style1">We ask that you keep</span><br/><span style="style1">our military operations confidential.</span></p>
<p xml:id="subtitle167" begin="5881250000t" end="5907500000t" region="region0"><span style="style1">You can rely on us</span><br/><span style="style1">for the utmost discretion.</span></p>
<p xml:id="subtitle168" begin="5954583334t" end="5966250000t" region="region0"><span style="style1">[door opens]</span></p>
<p xml:id="subtitle169" begin="5973333334t" end="5993333334t" region="region0"><span style="style1">[indistinct chatter]</span></p>
<p xml:id="subtitle170" begin="6012916667t" end="6027083334t" region="region0"><span style="style1">[sizzling]</span></p>
<p xml:id="subtitle171" begin="6048750000t" end="6072916667t" region="region0"><span style="style1">-I'll be home late again, Uncle.</span><br/><span style="style1">-Oh, Zuko!</span></p>
<p xml:id="subtitle172" begin="6073750000t" end="6096666667t" region="region0"><span style="style1">I have </span><span style="style2">jook </span><span style="style1">with bread and egg.</span></p>
<p xml:id="subtitle173" begin="6104583334t" end="6127500000t" region="region0"><span style="style1">I'll eat on the way to work.</span><br/><span style="style1">I don't wanna be late.</span></p>
<p xml:id="subtitle174" begin="6128333334t" end="6147083334t" region="region0"><span style="style1">I wanted to discuss that, actually.</span></p>
<p xml:id="subtitle175" begin="6147916667t" end="6190416667t" region="region0"><span style="style1">The owner of the tea shop is retiring,</span><br/><span style="style1">and well, if you want,</span></p>
<p xml:id="subtitle176" begin="6191250000t" end="6227500000t" region="region0"><span style="style1">I can offer you a good job</span><br/><span style="style1">with fair hours.</span></p>
<p xml:id="subtitle177" begin="6236666667t" end="6259583334t" region="region0"><span style="style1">No, but thank you.</span></p>
<p xml:id="subtitle178" begin="6260416667t" end="6274583334t" region="region0"><span style="style1">I… I have to go.</span></p>
<p xml:id="subtitle179" begin="6290000000t" end="6303750000t" region="region0"><span style="style1">[sighs]</span></p>
<p xml:id="subtitle180" begin="6313750000t" end="6325833334t" region="region0"><span style="style1">Excuse me.</span></p>
<p xml:id="subtitle181" begin="6333750000t" end="6343333334t" region="region0"><span style="style1">Right.</span></p>
<p xml:id="subtitle182" begin="6352500000t" end="6372083334t" region="region0"><span style="style1">You, hey. Um…</span></p>
<p xml:id="subtitle183" begin="6381250000t" end="6421250000t" region="region0"><span style="style1">Do you know of any, like,</span><br/><span style="style1">haunted houses around here?</span></p>
<p xml:id="subtitle184" begin="6473333334t" end="6484583334t" region="region0"><span style="style1">Didn't think so.</span></p>
<p xml:id="subtitle185" begin="6521250000t" end="6541250000t" region="region0"><span style="style1">[sniffing]</span></p>
<p xml:id="subtitle186" begin="6598750000t" end="6637916667t" region="region0"><span style="style1">[dishware clattering]</span></p>
<p xml:id="subtitle187" begin="6674583334t" end="6694583334t" region="region0"><span style="style1">[sniffing]</span></p>
<p xml:id="subtitle188" begin="6738333334t" end="6761666667t" region="region0"><span style="style1">Is that… pear and ginger?</span></p>
<p xml:id="subtitle189" begin="6803750000t" end="6832083334t" region="region0"><span style="style1">[Iroh] Yes, it is.</span><br/><span style="style1">I just added it to the menu.</span></p>
<p xml:id="subtitle190" begin="6837083334t" end="6845416667t" region="region0"><span style="style1">Allow me.</span></p>
<p xml:id="subtitle191" begin="6999583334t" end="7025416667t" region="region0"><span style="style1">It's meant to be quite therapeutic.</span></p>
<p xml:id="subtitle192" begin="7136666667t" end="7150416667t" region="region0"><span style="style1">[inhales deeply]</span></p>
<p xml:id="subtitle193" begin="7224166667t" end="7236250000t" region="region0"><span style="style1">[inhales deeply]</span></p>
<p xml:id="subtitle194" begin="7259166667t" end="7268333334t" region="region0"><span style="style1">[exhales]</span></p>
<p xml:id="subtitle195" begin="7295833334t" end="7307500000t" region="region0"><span style="style1">This is wonderful.</span></p>
<p xml:id="subtitle196" begin="7312500000t" end="7321666667t" region="region0"><span style="style1">[Iroh] Hmm.</span></p>
<p xml:id="subtitle197" begin="7350000000t" end="7380000000t" region="region0"><span style="style1">My mother used to brew this for me</span><br/><span style="style1">when I was little.</span></p>
<p xml:id="subtitle198" begin="7387500000t" end="7420416667t" region="region0"><span style="style1">Whenever I'd get sick, she'd stop working.</span></p>
<p xml:id="subtitle199" begin="7428750000t" end="7451250000t" region="region0"><span style="style1">She insisted she'd make it herself.</span></p>
<p xml:id="subtitle200" begin="7464583334t" end="7483333334t" region="region0"><span style="style1">She didn't like the way the cooks did it.</span></p>
<p xml:id="subtitle201" begin="7497500000t" end="7524166667t" region="region0"><span style="style1">&quot;Too dry,&quot; she'd complain.</span></p>
<p xml:id="subtitle202" begin="7539583334t" end="7566250000t" region="region0"><span style="style1">I never knew that a drink could be dry.</span></p>
<p xml:id="subtitle203" begin="7596666667t" end="7622083334t" region="region0"><span style="style1">And she'd just sit with me,</span></p>
<p xml:id="subtitle204" begin="7627083334t" end="7672500000t" region="region0"><span style="style1">reading, to make sure</span><br/><span style="style1">that I drank every last drop.</span></p>
<p xml:id="subtitle205" begin="7701250000t" end="7725833334t" region="region0"><span style="style1">It sounds like</span><br/><span style="style1">you have a very loving mother.</span></p>
<p xml:id="subtitle206" begin="7735833334t" end="7749583334t" region="region0"><span style="style1">No.</span></p>
<p xml:id="subtitle207" begin="7762083334t" end="7785416667t" region="region0"><span style="style1">No, my parents are not good people.</span></p>
<p xml:id="subtitle208" begin="7824166667t" end="7850416667t" region="region0"><span style="style1">I'm thinking about</span><br/><span style="style1">never speaking to them again.</span></p>
<p xml:id="subtitle209" begin="7865833334t" end="7875000000t" region="region0"><span style="style1">[Iroh inhales]</span></p>
<p xml:id="subtitle210" begin="7897083334t" end="7908333334t" region="region0"><span style="style1">[sighs]</span></p>
<p xml:id="subtitle211" begin="7922500000t" end="7957083334t" region="region0"><span style="style1">It's hard when you're young to understand.</span></p>
<p xml:id="subtitle212" begin="7975833334t" end="8000000000t" region="region0"><span style="style1">Navigating life is complicated.</span></p>
<p xml:id="subtitle213" begin="8014583334t" end="8064166667t" region="region0"><span style="style1">Most of the mistakes we made were choices</span><br/><span style="style1">that felt right in the moment.</span></p>
<p xml:id="subtitle214" begin="8065000000t" end="8075416667t" region="region0"><span style="style1">[Toph] Well,</span></p>
<p xml:id="subtitle215" begin="8082500000t" end="8117083334t" region="region0"><span style="style1">did you ever choose money</span><br/><span style="style1">over people's lives?</span></p>
<p xml:id="subtitle216" begin="8129166667t" end="8143750000t" region="region0"><span style="style1">That's what my parents did.</span></p>
<p xml:id="subtitle217" begin="8162083334t" end="8192500000t" region="region0"><span style="style1">I made lots of choices</span><br/><span style="style1">to protect my family.</span></p>
<p xml:id="subtitle218" begin="8203750000t" end="8227916667t" region="region0"><span style="style1">Now I can see that some of them were</span></p>
<p xml:id="subtitle219" begin="8241250000t" end="8250833334t" region="region0"><span style="style1">misguided.</span></p>
<p xml:id="subtitle220" begin="8266250000t" end="8307916667t" region="region0"><span style="style1">But still, I would choose</span><br/><span style="style1">to protect my nephew over anyone else.</span></p>
<p xml:id="subtitle221" begin="8344583334t" end="8360416667t" region="region0"><span style="style1">Do you think that's what he wants?</span></p>
<p xml:id="subtitle222" begin="8423750000t" end="8434166667t" region="region0"><span style="style1">I'm not sure.</span></p>
<p xml:id="subtitle223" begin="8450833334t" end="8472916667t" region="region0"><span style="style1">Do your parents know what </span><span style="style2">you </span><span style="style1">want?</span></p>
<p xml:id="subtitle224" begin="8488750000t" end="8498750000t" region="region0"><span style="style1">I think so.</span></p>
<p xml:id="subtitle225" begin="8530000000t" end="8582916667t" region="region0"><span style="style1">As we get older, we have to find the words</span><br/><span style="style1">to tell each other what we want.</span></p>
<p xml:id="subtitle226" begin="8595833334t" end="8612500000t" region="region0"><span style="style1">Even if those words are hurtful.</span></p>
<p xml:id="subtitle227" begin="8623750000t" end="8638750000t" region="region0"><span style="style1">[Toph sighs]</span></p>
<p xml:id="subtitle228" begin="8660416667t" end="8693750000t" region="region0"><span style="style1">I don't even know</span><br/><span style="style1">if I wanna give them a chance.</span></p>
<p xml:id="subtitle229" begin="8710416667t" end="8734583334t" region="region0"><span style="style1">Not unless they show</span><br/><span style="style1">that they could change.</span></p>
<p xml:id="subtitle230" begin="8768750000t" end="8793333334t" region="region0"><span style="style1">It takes true courage to change.</span></p>
<p xml:id="subtitle231" begin="8815416667t" end="8835416667t" region="region0"><span style="style1">I would say it doesn't hurt to ask,</span></p>
<p xml:id="subtitle232" begin="8836250000t" end="8892916667t" region="region0"><span style="style1">but I guess sometimes</span><br/><span style="style1">asking is what hurts the most.</span></p>
<p xml:id="subtitle233" begin="9014166667t" end="9023750000t" region="region0"><span style="style1">[sighs]</span></p>
<p xml:id="subtitle234" begin="9052500000t" end="9069166667t" region="region0"><span style="style1">[clears throat] Um…</span></p>
<p xml:id="subtitle235" begin="9084166667t" end="9094166667t" region="region0"><span style="style1">Anyway,</span></p>
<p xml:id="subtitle236" begin="9107500000t" end="9120000000t" region="region0"><span style="style1">thanks for the drink.</span></p>
<p xml:id="subtitle237" begin="9132500000t" end="9156666667t" region="region0"><span style="style1">And the advice, of course.</span></p>
<p xml:id="subtitle238" begin="9157500000t" end="9170416667t" region="region0"><span style="style1">Thank </span><span style="style2">you</span><span style="style1">.</span></p>
<p xml:id="subtitle239" begin="9175416667t" end="9217916667t" region="region0"><span style="style1">After all, sharing tea</span><br/><span style="style1">with a fascinating stranger</span></p>
<p xml:id="subtitle240" begin="9218750000t" end="9238750000t" region="region0"><span style="style1">is one of life's true delights.</span></p>
<p xml:id="subtitle241" begin="9274583334t" end="9287500000t" region="region0"><span style="style1">[Toph] Right.</span></p>
<p xml:id="subtitle242" begin="9288333334t" end="9300416667t" region="region0"><span style="style1">Stranger.</span></p>
<p xml:id="subtitle243" begin="9407083334t" end="9435416667t" region="region0"><span style="style1">These are your accommodations</span><br/><span style="style1">for your stay.</span></p>
<p xml:id="subtitle244" begin="9436250000t" end="9468750000t" region="region0"><span style="style1">After you settle in,</span><br/><span style="style1">I can show you to the marketplace.</span></p>
<p xml:id="subtitle245" begin="9516666667t" end="9537083334t" region="region0"><span style="style1">Thank you very much, Joo Dee.</span></p>
<p xml:id="subtitle246" begin="9548333334t" end="9583333334t" region="region0"><span style="style1">-Pardon the interruption.</span><br/><span style="style1">-Cultural Minister, what an honor.</span></p>
<p xml:id="subtitle247" begin="9593333334t" end="9605416667t" region="region0"><span style="style1">Just a quick visit.</span></p>
<p xml:id="subtitle248" begin="9614583334t" end="9655833334t" region="region0"><span style="style1">I could not miss the opportunity</span><br/><span style="style1">to meet the famed Kyoshi Warriors.</span></p>
<p xml:id="subtitle249" begin="9661666667t" end="9695416667t" region="region0"><span style="style1">I am Long Feng,</span><br/><span style="style1">Cultural Minister to the Earth King.</span></p>
<p xml:id="subtitle250" begin="9696250000t" end="9705000000t" region="region0"><span style="style1">A humble gift.</span></p>
<p xml:id="subtitle251" begin="9720000000t" end="9746250000t" region="region0"><span style="style1">Delicacies from your home island.</span></p>
<p xml:id="subtitle252" begin="9776666667t" end="9792500000t" region="region0"><span style="style1">Cultural Minister,</span></p>
<p xml:id="subtitle253" begin="9793333334t" end="9821666667t" region="region0"><span style="style1">it is an honor and a relief</span><br/><span style="style1">to meet a nobleman</span></p>
<p xml:id="subtitle254" begin="9822500000t" end="9842083334t" region="region0"><span style="style1">who reports directly to the king.</span></p>
<p xml:id="subtitle255" begin="9842916667t" end="9885000000t" region="region0"><span style="style1">The Kyoshi Warriors pledge</span><br/><span style="style1">absolute fealty to his grace.</span></p>
<p xml:id="subtitle256" begin="9894583334t" end="9913750000t" region="region0"><span style="style1">His Majesty will be pleased.</span></p>
<p xml:id="subtitle257" begin="9925000000t" end="9950000000t" region="region0"><span style="style1">My warrior sisters and I</span><br/><span style="style1">undertook great risk</span></p>
<p xml:id="subtitle258" begin="9950833334t" end="9977083334t" region="region0"><span style="style1">to capture the High Commander</span><br/><span style="style1">of the Fire Nation forces,</span></p>
<p xml:id="subtitle259" begin="9977916667t" end="10008750000t" region="region0"><span style="style1">and we want to be sure</span><br/><span style="style1">that the Earth King himself</span></p>
<p xml:id="subtitle260" begin="10009583334t" end="10030000000t" region="region0"><span style="style1">has a chance to interrogate this asset.</span></p>
<p xml:id="subtitle261" begin="10030833334t" end="10077083334t" region="region0"><span style="style1">I'm sure he will be kept abreast</span><br/><span style="style1">of the information gathered</span></p>
<p xml:id="subtitle262" begin="10077916667t" end="10104583334t" region="region0"><span style="style1">from the prisoner who is being held…</span></p>
<p xml:id="subtitle263" begin="10105416667t" end="10122500000t" region="region0"><span style="style1">By General Sung.</span></p>
<p xml:id="subtitle264" begin="10139166667t" end="10167500000t" region="region0"><span style="style1">They cautioned us to be discreet</span><br/><span style="style1">about what we say in the city,</span></p>
<p xml:id="subtitle265" begin="10168333334t" end="10184583334t" region="region0"><span style="style1">so I do hope I haven't overstepped.</span></p>
<p xml:id="subtitle266" begin="10185416667t" end="10200416667t" region="region0"><span style="style1">Of course not.</span></p>
<p xml:id="subtitle267" begin="10205416667t" end="10239166667t" region="region0"><span style="style1">Please, let Joo Dee know</span><br/><span style="style1">if you need anything.</span></p>
<p xml:id="subtitle268" begin="10256666667t" end="10274583334t" region="region0"><span style="style1">Joo Dee, a quick word?</span></p>
<p xml:id="subtitle269" begin="10353750000t" end="10373750000t" region="region0"><span style="style1">[suspenseful music playing]</span></p>
<p xml:id="subtitle270" begin="10392916667t" end="10414583334t" region="region0"><span style="style1">[Azula] What did you make</span><br/><span style="style1">of his body language, Ty Lee?</span></p>
<p xml:id="subtitle271" begin="10415416667t" end="10447500000t" region="region0"><span style="style1">He almost popped a blood vessel</span><br/><span style="style1">when you said General Sung's name.</span></p>
<p xml:id="subtitle272" begin="10448333334t" end="10481250000t" region="region0"><span style="style1">He clearly didn't know</span><br/><span style="style1">about Tran being held prisoner.</span></p>
<p xml:id="subtitle273" begin="10495000000t" end="10513333334t" region="region0"><span style="style1">You really think he'll tell the king?</span></p>
<p xml:id="subtitle274" begin="10532083334t" end="10556666667t" region="region0"><span style="style1">Information is power to someone like him.</span></p>
<p xml:id="subtitle275" begin="10557500000t" end="10590416667t" region="region0"><span style="style1">[suspenseful music swells, then fades]</span></p>
<p xml:id="subtitle276" begin="10608750000t" end="10618333334t" region="region0"><span style="style1">[Jet sighs]</span></p>
<p xml:id="subtitle277" begin="10641666667t" end="10656666667t" region="region0"><span style="style1">You treat all your merch like that?</span></p>
<p xml:id="subtitle278" begin="10657500000t" end="10679166667t" region="region0"><span style="style1">You're gonna melt it down</span><br/><span style="style1">for scrap anyway.</span></p>
<p xml:id="subtitle279" begin="10680000000t" end="10707083334t" region="region0"><span style="style1">Unless you're… you're buying a teapot</span><br/><span style="style1">for your granny.</span></p>
<p xml:id="subtitle280" begin="10730416667t" end="10747500000t" region="region0"><span style="style1">-Fifteen.</span><br/><span style="style1">-Twenty.</span></p>
<p xml:id="subtitle281" begin="10748333334t" end="10767916667t" region="region0"><span style="style1">Sixteen. Nineteen.</span></p>
<p xml:id="subtitle282" begin="10768750000t" end="10787916667t" region="region0"><span style="style1">Seventeen. Seventeen and a half.</span></p>
<p xml:id="subtitle283" begin="10788750000t" end="10808333334t" region="region0"><span style="style1">-[gasps] Deal.</span><br/><span style="style1">-[Jet] Deal.</span></p>
<p xml:id="subtitle284" begin="10830000000t" end="10840833334t" region="region0"><span style="style1">-[man] Look out!</span><br/><span style="style1">-[whooshing]</span></p>
<p xml:id="subtitle285" begin="10876250000t" end="10887500000t" region="region0"><span style="style1">Octopus shark!</span></p>
<p xml:id="subtitle286" begin="10892500000t" end="10908333334t" region="region0"><span style="style1">-Ah!</span><br/><span style="style1">-[knife clatters]</span></p>
<p xml:id="subtitle287" begin="10909166667t" end="10917500000t" region="region0"><span style="style1">Hey, Jet.</span></p>
<p xml:id="subtitle288" begin="10918333334t" end="10932083334t" region="region0"><span style="style1">[tense music playing]</span></p>
<p xml:id="subtitle289" begin="10954166667t" end="10970000000t" region="region0"><span style="style1">[Jet groans] Again?</span></p>
<p xml:id="subtitle290" begin="10975833334t" end="10986250000t" region="region0"><span style="style1">You can go.</span></p>
<p xml:id="subtitle291" begin="11002916667t" end="11014166667t" region="region0"><span style="style1">[Jet] Traitor!</span></p>
<p xml:id="subtitle292" begin="11015000000t" end="11043333334t" region="region0"><span style="style1">Can't believe you defended those people</span><br/><span style="style1">from the Fire Nation.</span></p>
<p xml:id="subtitle293" begin="11049166667t" end="11070000000t" region="region0"><span style="style1">What are you,</span><br/><span style="style1">some kind of flame lover now?</span></p>
<p xml:id="subtitle294" begin="11096666667t" end="11113333334t" region="region0"><span style="style1">[Katara] I didn't see</span><br/><span style="style1">any Firebenders there.</span></p>
<p xml:id="subtitle295" begin="11114166667t" end="11141666667t" region="region0"><span style="style1">Just a bunch of powerless people</span><br/><span style="style1">being bullied by looters.</span></p>
<p xml:id="subtitle296" begin="11142500000t" end="11162083334t" region="region0"><span style="style1">I don't need a lecture from you.</span></p>
<p xml:id="subtitle297" begin="11162916667t" end="11176666667t" region="region0"><span style="style1">I know about that do-gooding crap</span></p>
<p xml:id="subtitle298" begin="11177500000t" end="11194166667t" region="region0"><span style="style1">you've been up to</span><br/><span style="style1">in that disguise of yours.</span></p>
<p xml:id="subtitle299" begin="11200000000t" end="11222916667t" region="region0"><span style="style1">Healing the sick, feeding the poor.</span></p>
<p xml:id="subtitle300" begin="11223750000t" end="11258333334t" region="region0"><span style="style1">You should know, your little act</span><br/><span style="style1">isn't changing anyone's lives.</span></p>
<p xml:id="subtitle301" begin="11301666667t" end="11325833334t" region="region0"><span style="style1">[sighs] I came here</span><br/><span style="style1">because we need your help.</span></p>
<p xml:id="subtitle302" begin="11335833334t" end="11375833334t" region="region0"><span style="style1">I'm looking for a place in the Lower Ring,</span><br/><span style="style1">and you know your way around the streets.</span></p>
<p xml:id="subtitle303" begin="11380833334t" end="11397500000t" region="region0"><span style="style1">It's for the war.</span></p>
<p xml:id="subtitle304" begin="11409166667t" end="11419166667t" region="region0"><span style="style1">Sorry.</span></p>
<p xml:id="subtitle305" begin="11428750000t" end="11447083334t" region="region0"><span style="style1">I'm not a freedom fighter anymore.</span></p>
<p xml:id="subtitle306" begin="11465833334t" end="11476250000t" region="region0"><span style="style1">Too risky.</span></p>
<p xml:id="subtitle307" begin="11489583334t" end="11522916667t" region="region0"><span style="style1">You hate the Fire Nation enough</span><br/><span style="style1">to pick on a bunch of helpless people,</span></p>
<p xml:id="subtitle308" begin="11523750000t" end="11546666667t" region="region0"><span style="style1">but you can't do one thing</span><br/><span style="style1">to fight the real enemy.</span></p>
<p xml:id="subtitle309" begin="11547500000t" end="11586250000t" region="region0"><span style="style1">No. Now, if you'll excuse me,</span><br/><span style="style1">I have to go find a new buyer</span></p>
<p xml:id="subtitle310" begin="11587083334t" end="11627500000t" region="region0"><span style="style1">since you chased the last one off,</span><br/><span style="style1">and I was kind of hoping to eat tonight.</span></p>
<p xml:id="subtitle311" begin="11660416667t" end="11672500000t" region="region0"><span style="style1">I'll buy it.</span></p>
<p xml:id="subtitle312" begin="11692083334t" end="11714166667t" region="region0"><span style="style1">I'll buy it if you can help us.</span></p>
<p xml:id="subtitle313" begin="11723333334t" end="11735833334t" region="region0"><span style="style1">I'll pay you double.</span></p>
<p xml:id="subtitle314" begin="11744583334t" end="11759583334t" region="region0"><span style="style1">Triple and it's a deal.</span></p>
<p xml:id="subtitle315" begin="11774166667t" end="11820416667t" region="region0"><span style="style1">Eight hours of walking and all we found</span><br/><span style="style1">were those fried flour potatoes.</span></p>
<p xml:id="subtitle316" begin="11826250000t" end="11842083334t" region="region0"><span style="style1">Gave me indigestion.</span></p>
<p xml:id="subtitle317" begin="11849583334t" end="11870416667t" region="region0"><span style="style1">[Katara] Hey,</span><br/><span style="style1">I got someone who could help.</span></p>
<p xml:id="subtitle318" begin="11897500000t" end="11907500000t" region="region0"><span style="style1">Jet?!</span></p>
<p xml:id="subtitle319" begin="11915833334t" end="11938333334t" region="region0"><span style="style1">Katara? How could you bring him here?</span></p>
<p xml:id="subtitle320" begin="11939166667t" end="11952083334t" region="region0"><span style="style1">Uh, who is this guy?</span></p>
<p xml:id="subtitle321" begin="11952916667t" end="11968750000t" region="region0"><span style="style1">-I'm Jet.</span><br/><span style="style1">-He's a bad guy.</span></p>
<p xml:id="subtitle322" begin="11969583334t" end="11985000000t" region="region0"><span style="style1">He tried to kill Bumi.</span></p>
<p xml:id="subtitle323" begin="11985833334t" end="12011250000t" region="region0"><span style="style1">Hey, if you guys don't want my help,</span><br/><span style="style1">I can just go.</span></p>
<p xml:id="subtitle324" begin="12012083334t" end="12032083334t" region="region0"><span style="style1">He knows where the spirit scar is.</span></p>
<p xml:id="subtitle325" begin="12032916667t" end="12064166667t" region="region0"><span style="style1">We don't need help from a terrorist</span><br/><span style="style1">who tried to overthrow the government.</span></p>
<p xml:id="subtitle326" begin="12070833334t" end="12095000000t" region="region0"><span style="style1">Oh, wait, we're kind of trying</span><br/><span style="style1">to overthrow the government now.</span></p>
<p xml:id="subtitle327" begin="12100833334t" end="12120833334t" region="region0"><span style="style1">I like him. He stands with attitude.</span></p>
<p xml:id="subtitle328" begin="12133333334t" end="12145000000t" region="region0"><span style="style1">[Aang scoffs]</span></p>
<p xml:id="subtitle329" begin="12155833334t" end="12190833334t" region="region0"><span style="style1">You hated him before.</span><br/><span style="style1">Why are we supposed to trust him now?</span></p>
<p xml:id="subtitle330" begin="12191666667t" end="12222083334t" region="region0"><span style="style1">We don't need to trust him.</span><br/><span style="style1">I'm not asking you to.</span></p>
<p xml:id="subtitle331" begin="12233333334t" end="12250416667t" region="region0"><span style="style1">You just need to trust </span><span style="style2">me</span><span style="style1">.</span></p>
<p xml:id="subtitle332" begin="12275416667t" end="12300416667t" region="region0"><span style="style1">[mysterious music playing]</span></p>
<p xml:id="subtitle333" begin="12301250000t" end="12311666667t" region="region0"><span style="style1">[sighs]</span></p>
<p xml:id="subtitle334" begin="12391666667t" end="12402083334t" region="region0"><span style="style1">[music fades]</span></p>
<p xml:id="subtitle335" begin="12402916667t" end="12426250000t" region="region0"><span style="style1">Oh, Zuko, you're home.</span></p>
<p xml:id="subtitle336" begin="12427083334t" end="12448333334t" region="region0"><span style="style1">I'm just heading out. Night shift.</span></p>
<p xml:id="subtitle337" begin="12454583334t" end="12465000000t" region="region0"><span style="style1">Not yet.</span></p>
<p xml:id="subtitle338" begin="12472500000t" end="12486666667t" region="region0"><span style="style1">Not until we talk.</span></p>
<p xml:id="subtitle339" begin="12487500000t" end="12498750000t" region="region0"><span style="style1">We can talk later.</span></p>
<p xml:id="subtitle340" begin="12499583334t" end="12532916667t" region="region0"><span style="style1">Zuko, we've put this off for too long.</span></p>
<p xml:id="subtitle341" begin="12540833334t" end="12560000000t" region="region0"><span style="style1">Sit down, please.</span></p>
<p xml:id="subtitle342" begin="12613333334t" end="12622500000t" region="region0"><span style="style1">[Zuko sighs]</span></p>
<p xml:id="subtitle343" begin="12646250000t" end="12657500000t" region="region0"><span style="style1">[sighs]</span></p>
<p xml:id="subtitle344" begin="12755416667t" end="12773750000t" region="region0"><span style="style1">Back on the farm, what you said…</span></p>
<p xml:id="subtitle345" begin="12774583334t" end="12783333334t" region="region0"><span style="style1">I…</span></p>
<p xml:id="subtitle346" begin="12794583334t" end="12805833334t" region="region0"><span style="style1">I was angry.</span></p>
<p xml:id="subtitle347" begin="12822500000t" end="12854583334t" region="region0"><span style="style1">It wasn't right to blame you</span><br/><span style="style1">for what's happened to me.</span></p>
<p xml:id="subtitle348" begin="12855416667t" end="12865000000t" region="region0"><span style="style1">[Iroh] No.</span></p>
<p xml:id="subtitle349" begin="12872083334t" end="12884166667t" region="region0"><span style="style1">It was right.</span></p>
<p xml:id="subtitle350" begin="12893750000t" end="12922500000t" region="region0"><span style="style1">Everything you said was right.</span></p>
<p xml:id="subtitle351" begin="12940000000t" end="12977916667t" region="region0"><span style="style1">When my son died,</span><br/><span style="style1">I ran from my responsibility.</span></p>
<p xml:id="subtitle352" begin="12987500000t" end="13001250000t" region="region0"><span style="style1">I should have stood up.</span></p>
<p xml:id="subtitle353" begin="13012500000t" end="13039166667t" region="region0"><span style="style1">Every day I saw my brother with the crown,</span></p>
<p xml:id="subtitle354" begin="13040000000t" end="13050833334t" region="region0"><span style="style1">I felt it.</span></p>
<p xml:id="subtitle355" begin="13062083334t" end="13075833334t" region="region0"><span style="style1">What he did to you.</span></p>
<p xml:id="subtitle356" begin="13099166667t" end="13146666667t" region="region0"><span style="style1">I've been trying to be a father to you</span><br/><span style="style1">because I know how your father is.</span></p>
<p xml:id="subtitle357" begin="13155000000t" end="13178333334t" region="region0"><span style="style1">But I've also been trying to turn you</span></p>
<p xml:id="subtitle358" begin="13183333334t" end="13225833334t" region="region0"><span style="style1">into the man I hoped Lu Ten would be</span></p>
<p xml:id="subtitle359" begin="13234583334t" end="13263750000t" region="region0"><span style="style1">instead of helping you</span><br/><span style="style1">become your own man.</span></p>
<p xml:id="subtitle360" begin="13287500000t" end="13300416667t" region="region0"><span style="style1">That wasn't right.</span></p>
<p xml:id="subtitle361" begin="13317083334t" end="13328750000t" region="region0"><span style="style1">I'm sorry.</span></p>
<p xml:id="subtitle362" begin="13374583334t" end="13392916667t" region="region0"><span style="style1">And now it's time to make up for it.</span></p>
<p xml:id="subtitle363" begin="13397916667t" end="13421250000t" region="region0"><span style="style1">I'm ready to face my mistakes</span></p>
<p xml:id="subtitle364" begin="13426250000t" end="13437916667t" region="region0"><span style="style1">and correct them.</span></p>
<p xml:id="subtitle365" begin="13452083334t" end="13477916667t" region="region0"><span style="style1">I must ask you, too, Zuko,</span></p>
<p xml:id="subtitle366" begin="13478750000t" end="13513750000t" region="region0"><span style="style1">to choose what kind of man you want to be.</span></p>
<p xml:id="subtitle367" begin="13518750000t" end="13536250000t" region="region0"><span style="style1">But choose for yourself.</span></p>
<p xml:id="subtitle368" begin="13547083334t" end="13564583334t" region="region0"><span style="style1">And whatever you choose,</span></p>
<p xml:id="subtitle369" begin="13565416667t" end="13587916667t" region="region0"><span style="style1">whatever path you walk down,</span></p>
<p xml:id="subtitle370" begin="13599583334t" end="13619166667t" region="region0"><span style="style1">I will always love you.</span></p>
<p xml:id="subtitle371" begin="13677083334t" end="13697083334t" region="region0"><span style="style1">[sentimental music playing]</span></p>
<p xml:id="subtitle372" begin="13878750000t" end="13898750000t" region="region0"><span style="style1">[indistinct chatter]</span></p>
<p xml:id="subtitle373" begin="13929166667t" end="13969166667t" region="region0"><span style="style1">You know, what we really need</span><br/><span style="style1">are some aromatic bath salts.</span></p>
<p xml:id="subtitle374" begin="13970000000t" end="13991666667t" region="region0"><span style="style1">All of that roughing it, you know?</span></p>
<p xml:id="subtitle375" begin="13992500000t" end="14017916667t" region="region0"><span style="style1">Oh, yes. I know just the vendor.</span></p>
<p xml:id="subtitle376" begin="14035000000t" end="14053750000t" region="region0"><span style="style1">There's the grocer back there.</span></p>
<p xml:id="subtitle377" begin="14058750000t" end="14071250000t" region="region0"><span style="style1">And the bookish woman.</span></p>
<p xml:id="subtitle378" begin="14072083334t" end="14086250000t" region="region0"><span style="style1">[Mai] And Joo Dee is clearly a spy.</span></p>
<p xml:id="subtitle379" begin="14087083334t" end="14105833334t" region="region0"><span style="style1">This place is crawling.</span></p>
<p xml:id="subtitle380" begin="14112500000t" end="14142916667t" region="region0"><span style="style1">The military and the city rulers</span><br/><span style="style1">are in a cold war,</span></p>
<p xml:id="subtitle381" begin="14143750000t" end="14172916667t" region="region0"><span style="style1">and order is maintained through</span><br/><span style="style1">secret police and paranoia.</span></p>
<p xml:id="subtitle382" begin="14173750000t" end="14214166667t" region="region0"><span style="style1">Do you know what fuels</span><br/><span style="style1">all of this distrust and animosity?</span></p>
<p xml:id="subtitle383" begin="14232500000t" end="14244583334t" region="region0"><span style="style1">Weakness.</span></p>
<p xml:id="subtitle384" begin="14257916667t" end="14272916667t" region="region0"><span style="style1">The Earth King is weak.</span></p>
<p xml:id="subtitle385" begin="14292916667t" end="14317500000t" region="region0"><span style="style1">Maybe under the influence</span><br/><span style="style1">of some shadow ruler.</span></p>
<p xml:id="subtitle386" begin="14335416667t" end="14369166667t" region="region0"><span style="style1">If there is a shadow ruler,</span></p>
<p xml:id="subtitle387" begin="14370000000t" end="14387083334t" region="region0"><span style="style1">they would be the key.</span></p>
<p xml:id="subtitle388" begin="14387916667t" end="14413333334t" region="region0"><span style="style1">Might be open to listening to reason.</span></p>
<p xml:id="subtitle389" begin="14419166667t" end="14449583334t" region="region0"><span style="style1">As long as they're more afraid</span><br/><span style="style1">of losing control than they are of me.</span></p>
<p xml:id="subtitle390" begin="14456250000t" end="14474166667t" region="region0"><span style="style1">That hardly seems possible.</span></p>
<p xml:id="subtitle391" begin="14475000000t" end="14483750000t" region="region0"><span style="style1">[Azula] Hmm.</span></p>
<p xml:id="subtitle392" begin="14507083334t" end="14524583334t" region="region0"><span style="style1">It'd be fairly simple to catch my brother</span></p>
<p xml:id="subtitle393" begin="14525416667t" end="14547916667t" region="region0"><span style="style1">if I had a network of spies</span><br/><span style="style1">at my disposal.</span></p>
<p xml:id="subtitle394" begin="14577500000t" end="14610000000t" region="region0"><span style="style1">All we have to do now</span><br/><span style="style1">is figure out who the shadow ruler is.</span></p>
<p xml:id="subtitle395" begin="14619583334t" end="14633750000t" region="region0"><span style="style1">How do we do that?</span></p>
<p xml:id="subtitle396" begin="14653333334t" end="14681666667t" region="region0"><span style="style1">Unfortunately, we're going to</span><br/><span style="style1">have to do it the easy way.</span></p>
<p xml:id="subtitle397" begin="14705833334t" end="14720416667t" region="region0"><span style="style1">-Oh, Joo Dee?</span><br/><span style="style1">-Yes?</span></p>
<p xml:id="subtitle398" begin="14737500000t" end="14760833334t" region="region0"><span style="style1">[screams]</span></p>
<p xml:id="subtitle399" begin="14787083334t" end="14799166667t" region="region0"><span style="style1">[door opens]</span></p>
<p xml:id="subtitle400" begin="14844166667t" end="14855416667t" region="region0"><span style="style1">[door closes]</span></p>
<p xml:id="subtitle401" begin="14856250000t" end="14865416667t" region="region0"><span style="style1">Hello.</span></p>
<p xml:id="subtitle402" begin="14871666667t" end="14880833334t" region="region0"><span style="style1">Again.</span></p>
<p xml:id="subtitle403" begin="14904583334t" end="14920000000t" region="region0"><span style="style1">I suspected it might be you.</span></p>
<p xml:id="subtitle404" begin="14937916667t" end="14960833334t" region="region0"><span style="style1">We have a lot to discuss.</span></p>
<p xml:id="subtitle405" begin="14967916667t" end="14977916667t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle406" begin="14978750000t" end="15003333334t" region="region0"><span style="style1">[Zei] So you're telling me</span><br/><span style="style1">he bends the air around himself.</span></p>
<p xml:id="subtitle407" begin="15004166667t" end="15041666667t" region="region0"><span style="style1">[Aang] And us. That's why we don't swallow</span><br/><span style="style1">any flies when we're riding on top of him.</span></p>
<p xml:id="subtitle408" begin="15042500000t" end="15062500000t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle409" begin="15197083334t" end="15215416667t" region="region0"><span style="style1">[Jet] Found this spot</span><br/><span style="style1">when I first got here.</span></p>
<p xml:id="subtitle410" begin="15225000000t" end="15235416667t" region="region0"><span style="style1">Only stayed a night.</span></p>
<p xml:id="subtitle411" begin="15245416667t" end="15255833334t" region="region0"><span style="style1">Bad dreams.</span></p>
<p xml:id="subtitle412" begin="15291666667t" end="15304166667t" region="region0"><span style="style1">This is the place.</span></p>
<p xml:id="subtitle413" begin="15309166667t" end="15327500000t" region="region0"><span style="style1">I can almost feel it through the air.</span></p>
<p xml:id="subtitle414" begin="15337500000t" end="15352500000t" region="region0"><span style="style1">Thank you, Jet.</span></p>
<p xml:id="subtitle415" begin="15387500000t" end="15406250000t" region="region0"><span style="style1">[Katara] Job's done. So here.</span></p>
<p xml:id="subtitle416" begin="15415000000t" end="15425833334t" region="region0"><span style="style1">You can go now.</span></p>
<p xml:id="subtitle417" begin="15455000000t" end="15469583334t" region="region0"><span style="style1">So what happens now?</span></p>
<p xml:id="subtitle418" begin="15470416667t" end="15485833334t" region="region0"><span style="style1">[Sokka] Well, Aang's gonna meditate,</span></p>
<p xml:id="subtitle419" begin="15486666667t" end="15526250000t" region="region0"><span style="style1">we're gonna get pulled out of our bodies,</span><br/><span style="style1">and Appa and Momo are gonna stand guard.</span></p>
<p xml:id="subtitle420" begin="15531250000t" end="15551250000t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle421" begin="15572500000t" end="15591666667t" region="region0"><span style="style1">[Zei] Well, this is quite exciting.</span></p>
<p xml:id="subtitle422" begin="15592500000t" end="15623750000t" region="region0"><span style="style1">So, you're just gonna float around?</span></p>
<p xml:id="subtitle423" begin="15624583334t" end="15634583334t" region="region0"><span style="style1">Like ghosts?</span></p>
<p xml:id="subtitle424" begin="15635416667t" end="15646666667t" region="region0"><span style="style1">[Aang] Not quite.</span></p>
<p xml:id="subtitle425" begin="15647500000t" end="15669583334t" region="region0"><span style="style1">We'll be solid,</span><br/><span style="style1">but we won't be able to bend.</span></p>
<p xml:id="subtitle426" begin="15676250000t" end="15703750000t" region="region0"><span style="style1">You'll wanna step back.</span><br/><span style="style1">You might accidentally get sucked in.</span></p>
<p xml:id="subtitle427" begin="15704583334t" end="15722083334t" region="region0"><span style="style1">So, hold on. No bending?</span></p>
<p xml:id="subtitle428" begin="15728333334t" end="15745833334t" region="region0"><span style="style1">It sounds like</span><br/><span style="style1">you might need backup in there.</span></p>
<p xml:id="subtitle429" begin="15746666667t" end="15773333334t" region="region0"><span style="style1">Okay. Will you just</span><br/><span style="style1">make up your mind already?</span></p>
<p xml:id="subtitle430" begin="15774166667t" end="15788333334t" region="region0"><span style="style1">Maybe I can help.</span></p>
<p xml:id="subtitle431" begin="15807916667t" end="15833333334t" region="region0"><span style="style1">All righty. Let's do this, guys.</span></p>
<p xml:id="subtitle432" begin="15852916667t" end="15896250000t" region="region0"><span style="style1">[suspenseful music fades in]</span></p>
<p xml:id="subtitle433" begin="15942083334t" end="15962083334t" region="region0"><span style="style1">[music intensifying]</span></p>
<p xml:id="subtitle434" begin="16075833334t" end="16090833334t" region="region0"><span style="style1">[whirring]</span></p>
<p xml:id="subtitle435" begin="16114166667t" end="16137083334t" region="region0"><span style="style1">[mysterious music playing]</span></p>
<p xml:id="subtitle436" begin="16224583334t" end="16234583334t" region="region0"><span style="style1">[Zei] </span><span style="style2">I don't…</span></p>
<p xml:id="subtitle437" begin="16256250000t" end="16267916667t" region="region0"><span style="style2">I don't believe it.</span></p>
<p xml:id="subtitle438" begin="16282083334t" end="16300833334t" region="region0"><span style="style1">[Toph] </span><span style="style2">There's something there.</span></p>
<p xml:id="subtitle439" begin="16320416667t" end="16346666667t" region="region0"><span style="style2">Something beyond the door.</span></p>
<p xml:id="subtitle440" begin="16347500000t" end="16367916667t" region="region0"><span style="style2">I can feel it.</span></p>
<p xml:id="subtitle441" begin="16368750000t" end="16378750000t" region="region0"><span style="style1">[Sokka] </span><span style="style2">Feel what?</span></p>
<p xml:id="subtitle442" begin="16385000000t" end="16405000000t" region="region0"><span style="style1">[dramatic music playing]</span></p>
<p xml:id="subtitle443" begin="16551250000t" end="16560833334t" region="region0"><span style="style1">This.</span></p>
<p xml:id="subtitle444" begin="16850833334t" end="16888333334t" region="region0"><span style="style1">I've never been in</span><br/><span style="style1">a building this big before.</span></p>
<p xml:id="subtitle445" begin="16901666667t" end="16922916667t" region="region0"><span style="style1">-You can feel it?</span><br/><span style="style1">-[Toph] Yeah.</span></p>
<p xml:id="subtitle446" begin="16923750000t" end="16937083334t" region="region0"><span style="style1">I mean, I can't bend,</span></p>
<p xml:id="subtitle447" begin="16937916667t" end="16985416667t" region="region0"><span style="style1">but the acoustics and vibrations in here</span><br/><span style="style1">are sweet.</span></p>
<p xml:id="subtitle448" begin="17061666667t" end="17094166667t" region="region0"><span style="style1">[creature] The library</span><br/><span style="style1">is closed to humans!</span></p>
<p xml:id="subtitle449" begin="17142916667t" end="17158333334t" region="region0"><span style="style1">I said…</span></p>
<p xml:id="subtitle450" begin="17176250000t" end="17205416667t" region="region0"><span style="style1">Oh, it's you again.</span></p>
<p xml:id="subtitle451" begin="17216666667t" end="17241666667t" region="region0"><span style="style1">-You're that owl.</span><br/><span style="style1">-The spirit of knowledge.</span></p>
<p xml:id="subtitle452" begin="17242500000t" end="17270416667t" region="region0"><span style="style1">My name is Wan Shi Tong,</span></p>
<p xml:id="subtitle453" begin="17271250000t" end="17303333334t" region="region0"><span style="style1">he who knows ten thousand things.</span></p>
<p xml:id="subtitle454" begin="17304166667t" end="17320000000t" region="region0"><span style="style1">You talk human now?</span></p>
<p xml:id="subtitle455" begin="17320833334t" end="17345416667t" region="region0"><span style="style1">[Wan Shi Tong] And yet</span><br/><span style="style1">you still don't comprehend.</span></p>
<p xml:id="subtitle456" begin="17346250000t" end="17377083334t" region="region0"><span style="style1">This world is not for humans.</span></p>
<p xml:id="subtitle457" begin="17377916667t" end="17417083334t" region="region0"><span style="style1">You should've learned that</span><br/><span style="style1">after your dalliance with Koh.</span></p>
<p xml:id="subtitle458" begin="17422916667t" end="17457500000t" region="region0"><span style="style1">Wan Shi Tong, I'm the bridge</span><br/><span style="style1">between the human and Spirit World.</span></p>
<p xml:id="subtitle459" begin="17458333334t" end="17473750000t" region="region0"><span style="style1">Go home.</span></p>
<p xml:id="subtitle460" begin="17485416667t" end="17504583334t" region="region0"><span style="style1">I, Great Spirit,</span></p>
<p xml:id="subtitle461" begin="17505416667t" end="17535000000t" region="region0"><span style="style1">am Professor Zei, a fellow scholar and--</span></p>
<p xml:id="subtitle462" begin="17535833334t" end="17550833334t" region="region0"><span style="style1">I care not!</span></p>
<p xml:id="subtitle463" begin="17551666667t" end="17578750000t" region="region0"><span style="style1">This library has been off-limits to humans</span></p>
<p xml:id="subtitle464" begin="17579583334t" end="17620833334t" region="region0"><span style="style1">ever since firebending spies</span><br/><span style="style1">turned an entire wing to ash</span></p>
<p xml:id="subtitle465" begin="17621666667t" end="17648333334t" region="region0"><span style="style1">because they feared the information within</span></p>
<p xml:id="subtitle466" begin="17649166667t" end="17685833334t" region="region0"><span style="style1">would be used to defeat them</span><br/><span style="style1">on the battlefield.</span></p>
<p xml:id="subtitle467" begin="17686666667t" end="17698750000t" region="region0"><span style="style1">We wouldn't do that.</span></p>
<p xml:id="subtitle468" begin="17712083334t" end="17727083334t" region="region0"><span style="style1">I'm a friend of the Spirit World.</span></p>
<p xml:id="subtitle469" begin="17727916667t" end="17764583334t" region="region0"><span style="style1">I know of your misadventures, boy Avatar.</span></p>
<p xml:id="subtitle470" begin="17765416667t" end="17807500000t" region="region0"><span style="style1">The murder of Tui and the fury of La,</span></p>
<p xml:id="subtitle471" begin="17808333334t" end="17834166667t" region="region0"><span style="style1">the fury you harnessed</span></p>
<p xml:id="subtitle472" begin="17835000000t" end="17857916667t" region="region0"><span style="style1">to destroy your enemy.</span></p>
<p xml:id="subtitle473" begin="17858750000t" end="17883750000t" region="region0"><span style="style1">Your world is at war,</span></p>
<p xml:id="subtitle474" begin="17884583334t" end="17918333334t" region="region0"><span style="style1">and you desire to win that war.</span></p>
<p xml:id="subtitle475" begin="17919166667t" end="17969166667t" region="region0"><span style="style1">How could I trust</span><br/><span style="style1">your intentions are pacific?</span></p>
<p xml:id="subtitle476" begin="17978333334t" end="17989166667t" region="region0"><span style="style1">What about the rule…</span></p>
<p xml:id="subtitle477" begin="18012500000t" end="18054583334t" region="region0"><span style="style1">that a person only need offer</span><br/><span style="style1">their own worthy knowledge to be admitted?</span></p>
<p xml:id="subtitle478" begin="18122500000t" end="18161666667t" region="region0"><span style="style1">I offer this on our behalf.</span></p>
<p xml:id="subtitle479" begin="18170833334t" end="18201250000t" region="region0"><span style="style1">[Wan Shi Tong] Is this the map</span><br/><span style="style1">that guided you here?</span></p>
<p xml:id="subtitle480" begin="18202083334t" end="18211250000t" region="region0"><span style="style1">It is.</span></p>
<p xml:id="subtitle481" begin="18230000000t" end="18255416667t" region="region0"><span style="style1">A worthy offering, Professor.</span></p>
<p xml:id="subtitle482" begin="18297500000t" end="18341666667t" region="region0"><span style="style1">Promise that no knowledge gained</span><br/><span style="style1">within these walls</span></p>
<p xml:id="subtitle483" begin="18342500000t" end="18380000000t" region="region0"><span style="style1">will be used to harm anyone.</span></p>
<p xml:id="subtitle484" begin="18386250000t" end="18401666667t" region="region0"><span style="style1">You have our word.</span></p>
<p xml:id="subtitle485" begin="18436666667t" end="18447500000t" region="region0"><span style="style1">Very well.</span></p>
<p xml:id="subtitle486" begin="18448333334t" end="18472083334t" region="region0"><span style="style1">How will we find what we're looking for?</span></p>
<p xml:id="subtitle487" begin="18472916667t" end="18490000000t" region="region0"><span style="style1">[Wan Shi Tong] There are</span><br/><span style="style1">library assistants.</span></p>
<p xml:id="subtitle488" begin="18490833334t" end="18507083334t" region="region0"><span style="style1">Perhaps you'll find one.</span></p>
<p xml:id="subtitle489" begin="18507916667t" end="18535416667t" region="region0"><span style="style1">But the library works in its own way.</span></p>
<p xml:id="subtitle490" begin="18536250000t" end="18564166667t" region="region0"><span style="style1">It may choose to show you what you want,</span></p>
<p xml:id="subtitle491" begin="18565000000t" end="18602500000t" region="region0"><span style="style1">but it will certainly lead you</span><br/><span style="style1">to the knowledge that you need.</span></p>
<p xml:id="subtitle492" begin="18603333334t" end="18612916667t" region="region0"><span style="style1">[Aang gasps]</span></p>
<p xml:id="subtitle493" begin="18650833334t" end="18685416667t" region="region0"><span style="style1">Do not forget your promise!</span></p>
<p xml:id="subtitle494" begin="18760833334t" end="18769166667t" region="region0"><span style="style1">[Sokka groans]</span></p>
<p xml:id="subtitle495" begin="18778750000t" end="18801666667t" region="region0"><span style="style1">All right,</span><br/><span style="style1">let's split up into teams of two.</span></p>
<p xml:id="subtitle496" begin="18802500000t" end="18832500000t" region="region0"><span style="style1">We need to find proof of the comet</span><br/><span style="style1">and when it will be coming.</span></p>
<p xml:id="subtitle497" begin="18838333334t" end="18847500000t" region="region0"><span style="style1">[Sokka] Let's go.</span></p>
<p xml:id="subtitle498" begin="18875416667t" end="18900000000t" region="region0"><span style="style1">[Zei chuckles] Wow!</span></p>
<p xml:id="subtitle499" begin="18900833334t" end="18911666667t" region="region0"><span style="style1">This is…</span></p>
<p xml:id="subtitle500" begin="18924166667t" end="18951666667t" region="region0"><span style="style1">Whoa, this is incredible.</span></p>
<p xml:id="subtitle501" begin="18987500000t" end="19002500000t" region="region0"><span style="style1">Wait. [gasps]</span></p>
<p xml:id="subtitle502" begin="19008333334t" end="19020833334t" region="region0"><span style="style1">It can't be.</span></p>
<p xml:id="subtitle503" begin="19025833334t" end="19034583334t" region="region0"><span style="style1">It is!</span></p>
<p xml:id="subtitle504" begin="19039583334t" end="19057083334t" region="region0"><span style="style1">The collected essays of…</span></p>
<p xml:id="subtitle505" begin="19057916667t" end="19068750000t" region="region0"><span style="style1">No!</span></p>
<p xml:id="subtitle506" begin="19074583334t" end="19093333334t" region="region0"><span style="style1">Both editions! [chuckles]</span></p>
<p xml:id="subtitle507" begin="19098333334t" end="19108750000t" region="region0"><span style="style1">-[Sokka] Huh.</span><br/><span style="style1">-[Zei] Oh.</span></p>
<p xml:id="subtitle508" begin="19109583334t" end="19144166667t" region="region0"><span style="style1">Personal accounts of the solitary travels</span><br/><span style="style1">of Sun Wen Lei. [gasps]</span></p>
<p xml:id="subtitle509" begin="19145000000t" end="19154583334t" region="region0"><span style="style1">[Sokka] Professor Zei?</span></p>
<p xml:id="subtitle510" begin="19155416667t" end="19170833334t" region="region0"><span style="style1">Oh, I'm sorry. Um…</span></p>
<p xml:id="subtitle511" begin="19171666667t" end="19203333334t" region="region0"><span style="style1">I know. The comet first</span><br/><span style="style1">and then onto these, uh, treasures.</span></p>
<p xml:id="subtitle512" begin="19204166667t" end="19232500000t" region="region0"><span style="style1">No, it's okay. If you wanna stop and read,</span><br/><span style="style1">I can go ahead and look for--</span></p>
<p xml:id="subtitle513" begin="19233333334t" end="19253333334t" region="region0"><span style="style1">Oh, I'd like that very much, yes.</span></p>
<p xml:id="subtitle514" begin="19284166667t" end="19294166667t" region="region0"><span style="style1">Okay.</span></p>
<p xml:id="subtitle515" begin="19320000000t" end="19328333334t" region="region0"><span style="style1">Excuse me.</span></p>
<p xml:id="subtitle516" begin="19329166667t" end="19350833334t" region="region0"><span style="style1">Are you a library assistant?</span></p>
<p xml:id="subtitle517" begin="19394166667t" end="19407083334t" region="region0"><span style="style1">You're a fox.</span></p>
<p xml:id="subtitle518" begin="19422916667t" end="19452916667t" region="region0"><span style="style1">Oh, uh, I, uh… I knew another fox.</span></p>
<p xml:id="subtitle519" begin="19459583334t" end="19483333334t" region="region0"><span style="style1">Well, she was a white fox</span><br/><span style="style1">in the Spirit World,</span></p>
<p xml:id="subtitle520" begin="19484166667t" end="19503333334t" region="region0"><span style="style1">but she was a human out there.</span></p>
<p xml:id="subtitle521" begin="19515416667t" end="19532500000t" region="region0"><span style="style1">Her name… her name was Yue.</span></p>
<p xml:id="subtitle522" begin="19537500000t" end="19556250000t" region="region0"><span style="style1">Uh, do you know her?</span></p>
<p xml:id="subtitle523" begin="19565833334t" end="19583333334t" region="region0"><span style="style1">She here? Is…</span></p>
<p xml:id="subtitle524" begin="19592500000t" end="19617500000t" region="region0"><span style="style1">This is the Spirit World.</span><br/><span style="style1">She could be here, right?</span></p>
<p xml:id="subtitle525" begin="19695416667t" end="19705416667t" region="region0"><span style="style1">That feels like a yes.</span></p>
<p xml:id="subtitle526" begin="19731250000t" end="19748333334t" region="region0"><span style="style1">[snapping fingers]</span></p>
<p xml:id="subtitle527" begin="19763333334t" end="19782500000t" region="region0"><span style="style1">[Aang] This must be the Avatar section.</span></p>
<p xml:id="subtitle528" begin="19806666667t" end="19816250000t" region="region0"><span style="style1">[Toph] Let's see…</span></p>
<p xml:id="subtitle529" begin="19840416667t" end="19848750000t" region="region0"><span style="style1">[scoffs]</span></p>
<p xml:id="subtitle530" begin="19860416667t" end="19868750000t" region="region0"><span style="style1">Whoa.</span></p>
<p xml:id="subtitle531" begin="19883333334t" end="19897083334t" region="region0"><span style="style1">Raised characters?</span></p>
<p xml:id="subtitle532" begin="19902083334t" end="19929166667t" region="region0"><span style="style1">Man, this library rules. [chuckles]</span></p>
<p xml:id="subtitle533" begin="19957083334t" end="19982500000t" region="region0"><span style="style1">One of the previous Avatars</span><br/><span style="style1">must've experienced the comet</span></p>
<p xml:id="subtitle534" begin="19983333334t" end="19995416667t" region="region0"><span style="style1">and knows what it does.</span></p>
<p xml:id="subtitle535" begin="20002500000t" end="20029166667t" region="region0"><span style="style1">All right, well, I'll get reading.</span></p>
<p xml:id="subtitle536" begin="20267083334t" end="20285833334t" region="region0"><span style="style1">The journals of Yangchen.</span></p>
<p xml:id="subtitle537" begin="20295833334t" end="20311250000t" region="region0"><span style="style1">[Yangchen] That one was a decoy.</span></p>
<p xml:id="subtitle538" begin="20316250000t" end="20327916667t" region="region0"><span style="style1">Pure fiction.</span></p>
<p xml:id="subtitle539" begin="20337916667t" end="20360833334t" region="region0"><span style="style1">But you can ask me</span><br/><span style="style1">whatever you want, Aang.</span></p>
<p xml:id="subtitle540" begin="20361666667t" end="20381666667t" region="region0"><span style="style1">[poignant music playing]</span></p>
<p xml:id="subtitle541" begin="20400000000t" end="20413750000t" region="region0"><span style="style1">Oh. [chuckles]</span></p>
<p xml:id="subtitle542" begin="20419583334t" end="20457083334t" region="region0"><span style="style1">I suppose you haven't seen</span><br/><span style="style1">another Air Nomad in some time.</span></p>
<p xml:id="subtitle543" begin="20556666667t" end="20568750000t" region="region0"><span style="style1">[Jet] So,</span></p>
<p xml:id="subtitle544" begin="20585416667t" end="20629583334t" region="region0"><span style="style1">are we just supposed to read books</span><br/><span style="style1">until we find an answer?</span></p>
<p xml:id="subtitle545" begin="20639583334t" end="20648750000t" region="region0"><span style="style1">I don't know.</span></p>
<p xml:id="subtitle546" begin="20717083334t" end="20755416667t" region="region0"><span style="style1">It's a bit of an odd section,</span><br/><span style="style1">given how anti-war that bird's speech was.</span></p>
<p xml:id="subtitle547" begin="20761666667t" end="20787916667t" region="region0"><span style="style1">[Katara] There must be something in here</span><br/><span style="style1">we're supposed to learn.</span></p>
<p xml:id="subtitle548" begin="20799166667t" end="20817500000t" region="region0"><span style="style1">How to win an unwinnable war?</span></p>
<p xml:id="subtitle549" begin="20871666667t" end="20885416667t" region="region0"><span style="style1">[Yangchen] </span><span style="style2">So how are you, Aang?</span></p>
<p xml:id="subtitle550" begin="20890416667t" end="20902916667t" region="region0"><span style="style1">It's been hard.</span></p>
<p xml:id="subtitle551" begin="20910833334t" end="20954166667t" region="region0"><span style="style1">We brought these refugees to Ba Sing Se,</span><br/><span style="style1">and when we got here,</span></p>
<p xml:id="subtitle552" begin="20961250000t" end="20988750000t" region="region0"><span style="style1">I trusted this guy, Long Feng.</span></p>
<p xml:id="subtitle553" begin="20989583334t" end="21021666667t" region="region0"><span style="style1">But he was a liar,</span><br/><span style="style1">and the Great Comet's on the way back,</span></p>
<p xml:id="subtitle554" begin="21022500000t" end="21042916667t" region="region0"><span style="style1">and I don't feel like I can trust anyone.</span></p>
<p xml:id="subtitle555" begin="21048333334t" end="21069583334t" region="region0"><span style="style1">Feels like even my friends</span><br/><span style="style1">are keeping things from me.</span></p>
<p xml:id="subtitle556" begin="21070416667t" end="21108333334t" region="region0"><span style="style1">I spent most of my life</span><br/><span style="style1">dealing with spies and liars.</span></p>
<p xml:id="subtitle557" begin="21113333334t" end="21152916667t" region="region0"><span style="style1">If you need guidance on trusting people,</span><br/><span style="style1">you've come to the right place.</span></p>
<p xml:id="subtitle558" begin="21187916667t" end="21197916667t" region="region0"><span style="style1">[chuckles]</span></p>
<p xml:id="subtitle559" begin="21207916667t" end="21225000000t" region="region0"><span style="style1">Man, she is something.</span></p>
<p xml:id="subtitle560" begin="21236666667t" end="21255000000t" region="region0"><span style="style1">-Finding my life entertaining?</span><br/><span style="style1">-Oh jeez.</span></p>
<p xml:id="subtitle561" begin="21271250000t" end="21280000000t" region="region0"><span style="style1">Who are you?</span></p>
<p xml:id="subtitle562" begin="21280833334t" end="21298333334t" region="region0"><span style="style1">Kyoshi. Where's Aang?</span></p>
<p xml:id="subtitle563" begin="21306666667t" end="21324583334t" region="region0"><span style="style1">He's back there somewhere.</span></p>
<p xml:id="subtitle564" begin="21331250000t" end="21350000000t" region="region0"><span style="style1">I'm the earthbending teacher, by the way.</span></p>
<p xml:id="subtitle565" begin="21350833334t" end="21361250000t" region="region0"><span style="style1">But you're a child.</span></p>
<p xml:id="subtitle566" begin="21362083334t" end="21376250000t" region="region0"><span style="style1">Yeah, well, you're dead.</span></p>
<p xml:id="subtitle567" begin="21382500000t" end="21398333334t" region="region0"><span style="style1">Is this normal for you?</span></p>
<p xml:id="subtitle568" begin="21399166667t" end="21436666667t" region="region0"><span style="style1">Do you jump out of books all the time,</span><br/><span style="style1">or is this just a Spirit Library thing?</span></p>
<p xml:id="subtitle569" begin="21437500000t" end="21464166667t" region="region0"><span style="style1">It's a being close to the Avatar thing.</span></p>
<p xml:id="subtitle570" begin="21486250000t" end="21497083334t" region="region0"><span style="style1">What's your name?</span></p>
<p xml:id="subtitle571" begin="21511666667t" end="21520000000t" region="region0"><span style="style1">Toph.</span></p>
<p xml:id="subtitle572" begin="21533750000t" end="21543333334t" region="region0"><span style="style1">Beifong.</span></p>
<p xml:id="subtitle573" begin="21555000000t" end="21572916667t" region="region0"><span style="style1">I dislike your family greatly.</span></p>
<p xml:id="subtitle574" begin="21577500000t" end="21587083334t" region="region0"><span style="style1">[Toph] Yeah, well,</span></p>
<p xml:id="subtitle575" begin="21599583334t" end="21610833334t" region="region0"><span style="style1">me too.</span></p>
<p xml:id="subtitle576" begin="21627500000t" end="21648333334t" region="region0"><span style="style1">[sighs] What do you want from the Avatar?</span></p>
<p xml:id="subtitle577" begin="21655416667t" end="21683333334t" region="region0"><span style="style1">I just want to teach him earthbending.</span></p>
<p xml:id="subtitle578" begin="21692500000t" end="21717916667t" region="region0"><span style="style1">I mean, I ran away</span><br/><span style="style1">from my family to do it.</span></p>
<p xml:id="subtitle579" begin="21718750000t" end="21742500000t" region="region0"><span style="style1">Your family is not so easy to escape.</span></p>
<p xml:id="subtitle580" begin="21743333334t" end="21766250000t" region="region0"><span style="style1">[scoffs] So I'm finding.</span></p>
<p xml:id="subtitle581" begin="21767083334t" end="21817500000t" region="region0"><span style="style1">I guess I thought I did escape</span><br/><span style="style1">with Aang and Katara and Sokka.</span></p>
<p xml:id="subtitle582" begin="21836666667t" end="21858333334t" region="region0"><span style="style1">It's kind of the first time</span><br/><span style="style1">I've had friends.</span></p>
<p xml:id="subtitle583" begin="21870416667t" end="21882500000t" region="region0"><span style="style1">A new family.</span></p>
<p xml:id="subtitle584" begin="21895416667t" end="21906250000t" region="region0"><span style="style1">I guess so.</span></p>
<p xml:id="subtitle585" begin="21919583334t" end="21956250000t" region="region0"><span style="style1">I really, really don't want</span><br/><span style="style1">to let them down.</span></p>
<p xml:id="subtitle586" begin="21957083334t" end="21971666667t" region="region0"><span style="style1">Oh. [sighs]</span></p>
<p xml:id="subtitle587" begin="21976666667t" end="22003750000t" region="region0"><span style="style1">You will. Eventually, in some way.</span></p>
<p xml:id="subtitle588" begin="22004583334t" end="22028333334t" region="region0"><span style="style1">But if you've chosen your friends well,</span></p>
<p xml:id="subtitle589" begin="22036666667t" end="22050833334t" region="region0"><span style="style1">they'll understand.</span></p>
<p xml:id="subtitle590" begin="22051666667t" end="22064583334t" region="region0"><span style="style1">What if they don't?</span></p>
<p xml:id="subtitle591" begin="22078333334t" end="22088750000t" region="region0"><span style="style1">Because of who I am.</span></p>
<p xml:id="subtitle592" begin="22089583334t" end="22110416667t" region="region0"><span style="style1">You worry too much about your surname.</span></p>
<p xml:id="subtitle593" begin="22122500000t" end="22143750000t" region="region0"><span style="style1">My parents were not good people either.</span></p>
<p xml:id="subtitle594" begin="22153750000t" end="22165833334t" region="region0"><span style="style1">Who were your parents?</span></p>
<p xml:id="subtitle595" begin="22166666667t" end="22176250000t" region="region0"><span style="style1">[Kyoshi sighs]</span></p>
<p xml:id="subtitle596" begin="22193333334t" end="22204166667t" region="region0"><span style="style1">Exactly.</span></p>
<p xml:id="subtitle597" begin="22210000000t" end="22219583334t" region="region0"><span style="style1">[laughs]</span></p>
<p xml:id="subtitle598" begin="22284583334t" end="22293750000t" region="region0"><span style="style1">[fox yelps]</span></p>
<p xml:id="subtitle599" begin="22429166667t" end="22442083334t" region="region0"><span style="style1">Am I supposed to pull that?</span></p>
<p xml:id="subtitle600" begin="22487500000t" end="22506666667t" region="region0"><span style="style1">[clanking]</span></p>
<p xml:id="subtitle601" begin="22517083334t" end="22537083334t" region="region0"><span style="style1">[dramatic music playing]</span></p>
<p xml:id="subtitle602" begin="23073750000t" end="23088333334t" region="region0"><span style="style1">[Sokka] It's not you, is it?</span></p>
<p xml:id="subtitle603" begin="23115416667t" end="23157916667t" region="region0"><span style="style1">I… I just thought if I looked hard enough,</span><br/><span style="style1">I could see you.</span></p>
<p xml:id="subtitle604" begin="23164166667t" end="23201250000t" region="region0"><span style="style1">Or if… if I listened the right way,</span><br/><span style="style1">I could hear you.</span></p>
<p xml:id="subtitle605" begin="23252083334t" end="23275833334t" region="region0"><span style="style1">Aang and Katara say I'm the plan man now.</span></p>
<p xml:id="subtitle606" begin="23297083334t" end="23319583334t" region="region0"><span style="style1">The person who comes up with a solution.</span></p>
<p xml:id="subtitle607" begin="23359583334t" end="23389166667t" region="region0"><span style="style1">If… if I had been this person</span></p>
<p xml:id="subtitle608" begin="23404166667t" end="23415416667t" region="region0"><span style="style1">back then,</span></p>
<p xml:id="subtitle609" begin="23433333334t" end="23443750000t" region="region0"><span style="style1">that day…</span></p>
<p xml:id="subtitle610" begin="23463750000t" end="23477500000t" region="region0"><span style="style1">could I have saved you?</span></p>
<p xml:id="subtitle611" begin="23545833334t" end="23567500000t" region="region0"><span style="style1">Or am I only this person now…</span></p>
<p xml:id="subtitle612" begin="23597500000t" end="23609583334t" region="region0"><span style="style1">because of you?</span></p>
<p xml:id="subtitle613" begin="23645000000t" end="23674166667t" region="region0"><span style="style1">-[Yangchen] </span><span style="style2">You have to risk being hurt.</span><br/><span style="style2">-</span><span style="style1">[music fades]</span></p>
<p xml:id="subtitle614" begin="23675000000t" end="23715000000t" region="region0"><span style="style1">In my time, I was betrayed</span><br/><span style="style1">by one of my closest friends.</span></p>
<p xml:id="subtitle615" begin="23720000000t" end="23744583334t" region="region0"><span style="style1">You didn't know Long Feng was a liar.</span></p>
<p xml:id="subtitle616" begin="23745416667t" end="23765416667t" region="region0"><span style="style1">You just knew you needed help.</span></p>
<p xml:id="subtitle617" begin="23772916667t" end="23815000000t" region="region0"><span style="style1">Without putting trust in others,</span><br/><span style="style1">the weight of this role will crush you.</span></p>
<p xml:id="subtitle618" begin="23825833334t" end="23852500000t" region="region0"><span style="style1">But I thought I knew people.</span></p>
<p xml:id="subtitle619" begin="23860000000t" end="23881666667t" region="region0"><span style="style1">I thought I could see</span><br/><span style="style1">if there was good in them.</span></p>
<p xml:id="subtitle620" begin="23882500000t" end="23900416667t" region="region0"><span style="style1">And, if I needed to,</span></p>
<p xml:id="subtitle621" begin="23915833334t" end="23938333334t" region="region0"><span style="style1">convince them to be good.</span></p>
<p xml:id="subtitle622" begin="23939166667t" end="23950833334t" region="region0"><span style="style1">[Yangchen scoffs]</span></p>
<p xml:id="subtitle623" begin="23951666667t" end="23970000000t" region="region0"><span style="style1">That's a lot to ask of yourself.</span></p>
<p xml:id="subtitle624" begin="23970833334t" end="23993750000t" region="region0"><span style="style1">You can't control other people.</span></p>
<p xml:id="subtitle625" begin="23994583334t" end="24017083334t" region="region0"><span style="style1">You can only control your own actions.</span></p>
<p xml:id="subtitle626" begin="24017916667t" end="24037083334t" region="region0"><span style="style1">Then my actions need to be better.</span></p>
<p xml:id="subtitle627" begin="24043333334t" end="24063750000t" region="region0"><span style="style1">I need to be so much better than I am.</span></p>
<p xml:id="subtitle628" begin="24074583334t" end="24113750000t" region="region0"><span style="style1">Every Avatar feels like</span><br/><span style="style1">they're the most important Avatar</span></p>
<p xml:id="subtitle629" begin="24114583334t" end="24126666667t" region="region0"><span style="style1">that ever lived.</span></p>
<p xml:id="subtitle630" begin="24132916667t" end="24152500000t" region="region0"><span style="style1">But we all make mistakes.</span></p>
<p xml:id="subtitle631" begin="24164166667t" end="24204166667t" region="region0"><span style="style1">I thought I was so successful</span><br/><span style="style1">at maintaining peace.</span></p>
<p xml:id="subtitle632" begin="24205000000t" end="24257083334t" region="region0"><span style="style1">But my actions angered the Spirit World,</span><br/><span style="style1">and Avatar Kuruk paid a huge price.</span></p>
<p xml:id="subtitle633" begin="24262916667t" end="24307500000t" region="region0"><span style="style1">No Avatar can succeed</span><br/><span style="style1">at balancing everything forever.</span></p>
<p xml:id="subtitle634" begin="24319583334t" end="24350833334t" region="region0"><span style="style1">That's why we'll always need</span><br/><span style="style1">the next Avatar.</span></p>
<p xml:id="subtitle635" begin="24361250000t" end="24370833334t" region="region0"><span style="style1">Well,</span></p>
<p xml:id="subtitle636" begin="24380000000t" end="24401250000t" region="region0"><span style="style1">that's a little comforting.</span></p>
<p xml:id="subtitle637" begin="24410000000t" end="24428750000t" region="region0"><span style="style1">At least I know</span><br/><span style="style1">if I don't accomplish everything,</span></p>
<p xml:id="subtitle638" begin="24429583334t" end="24456250000t" region="region0"><span style="style1">there will always be another one after me.</span></p>
<p xml:id="subtitle639" begin="24457083334t" end="24470416667t" region="region0"><span style="style1">Unless there isn't.</span></p>
<p xml:id="subtitle640" begin="24498333334t" end="24519166667t" region="region0"><span style="style1">When you're in the Avatar State,</span></p>
<p xml:id="subtitle641" begin="24520000000t" end="24555416667t" region="region0"><span style="style1">you're channeling the power</span><br/><span style="style1">of all the previous Avatars.</span></p>
<p xml:id="subtitle642" begin="24561250000t" end="24582083334t" region="region0"><span style="style1">If you die in that state,</span></p>
<p xml:id="subtitle643" begin="24582916667t" end="24606250000t" region="region0"><span style="style1">the cycle will cease.</span></p>
<p xml:id="subtitle644" begin="24621250000t" end="24650000000t" region="region0"><span style="style1">No… reincarnation?</span></p>
<p xml:id="subtitle645" begin="24663333334t" end="24686250000t" region="region0"><span style="style1">The end of the Avatar forever.</span></p>
<p xml:id="subtitle646" begin="24687083334t" end="24697083334t" region="region0"><span style="style1">Correct.</span></p>
<p xml:id="subtitle647" begin="24707083334t" end="24740833334t" region="region0"><span style="style1">And the world will fall</span><br/><span style="style1">out of balance forever.</span></p>
<p xml:id="subtitle648" begin="24782916667t" end="24792083334t" region="region0"><span style="style1">Well…</span></p>
<p xml:id="subtitle649" begin="24805416667t" end="24817916667t" region="region0"><span style="style1">Fine. It's fine.</span></p>
<p xml:id="subtitle650" begin="24818750000t" end="24853750000t" region="region0"><span style="style1">I can't really control it anyway,</span></p>
<p xml:id="subtitle651" begin="24854583334t" end="24869166667t" region="region0"><span style="style1">so I don't use it.</span></p>
<p xml:id="subtitle652" begin="24870000000t" end="24880000000t" region="region0"><span style="style1">Not yet.</span></p>
<p xml:id="subtitle653" begin="24885416667t" end="24907916667t" region="region0"><span style="style1">But as your mastery of the elements grows,</span></p>
<p xml:id="subtitle654" begin="24908750000t" end="24941250000t" region="region0"><span style="style1">your control of the Avatar State</span><br/><span style="style1">grows too.</span></p>
<p xml:id="subtitle655" begin="24942083334t" end="24979166667t" region="region0"><span style="style1">First, bringing yourself into it</span><br/><span style="style1">and out of it at will.</span></p>
<p xml:id="subtitle656" begin="24980000000t" end="24993750000t" region="region0"><span style="style1">Then precision.</span></p>
<p xml:id="subtitle657" begin="24994583334t" end="25016666667t" region="region0"><span style="style1">So now that I can waterbend and earthbend…</span></p>
<p xml:id="subtitle658" begin="25017500000t" end="25044166667t" region="region0"><span style="style1">You're probably stronger than you know.</span></p>
<p xml:id="subtitle659" begin="25050000000t" end="25060000000t" region="region0"><span style="style1">So,</span></p>
<p xml:id="subtitle660" begin="25070000000t" end="25104583334t" region="region0"><span style="style1">I could use the Avatar State</span><br/><span style="style1">against the Fire Nation.</span></p>
<p xml:id="subtitle661" begin="25109583334t" end="25131666667t" region="region0"><span style="style1">I could tell the king that's the plan</span><br/><span style="style1">if I needed to.</span></p>
<p xml:id="subtitle662" begin="25132500000t" end="25149583334t" region="region0"><span style="style1">Aang, I implore you.</span></p>
<p xml:id="subtitle663" begin="25155416667t" end="25177500000t" region="region0"><span style="style1">Wield this power wisely.</span></p>
<p xml:id="subtitle664" begin="25182500000t" end="25196666667t" region="region0"><span style="style1">Stay alive.</span></p>
<p xml:id="subtitle665" begin="25235000000t" end="25255000000t" region="region0"><span style="style1">[Katara] It just started with a sick girl.</span></p>
<p xml:id="subtitle666" begin="25255833334t" end="25298333334t" region="region0"><span style="style1">She needed golden nettles,</span><br/><span style="style1">and I couldn't risk being identified.</span></p>
<p xml:id="subtitle667" begin="25307916667t" end="25325000000t" region="region0"><span style="style1">Because it might look bad for Aang?</span></p>
<p xml:id="subtitle668" begin="25339166667t" end="25358750000t" region="region0"><span style="style1">He seems like he'd understand.</span></p>
<p xml:id="subtitle669" begin="25363750000t" end="25380000000t" region="region0"><span style="style1">I don't need him to, though.</span></p>
<p xml:id="subtitle670" begin="25392916667t" end="25410000000t" region="region0"><span style="style1">I don't need you to either.</span></p>
<p xml:id="subtitle671" begin="25435833334t" end="25463750000t" region="region0"><span style="style1">It's just something that I had to do.</span></p>
<p xml:id="subtitle672" begin="25491250000t" end="25534583334t" region="region0"><span style="style1">So you looked in the mirror,</span><br/><span style="style1">decided to do something just for you,</span></p>
<p xml:id="subtitle673" begin="25539583334t" end="25560000000t" region="region0"><span style="style1">and you became a hero.</span></p>
<p xml:id="subtitle674" begin="25566250000t" end="25580416667t" region="region0"><span style="style1">A masked avenger?</span></p>
<p xml:id="subtitle675" begin="25585416667t" end="25596250000t" region="region0"><span style="style1">[laughs]</span></p>
<p xml:id="subtitle676" begin="25605833334t" end="25630833334t" region="region0"><span style="style1">I looked in the mirror</span><br/><span style="style1">and became a lying thief.</span></p>
<p xml:id="subtitle677" begin="25642500000t" end="25657500000t" region="region0"><span style="style1">Useless to everyone.</span></p>
<p xml:id="subtitle678" begin="25693333334t" end="25718333334t" region="region0"><span style="style1">You had your money. You could've gone.</span></p>
<p xml:id="subtitle679" begin="25727500000t" end="25758750000t" region="region0"><span style="style1">But you came with us</span><br/><span style="style1">because you do wanna help.</span></p>
<p xml:id="subtitle680" begin="25763750000t" end="25796666667t" region="region0"><span style="style1">You're still a freedom fighter,</span><br/><span style="style1">whether you admit it or not.</span></p>
<p xml:id="subtitle681" begin="25807083334t" end="25817916667t" region="region0"><span style="style1">[Jet sighs]</span></p>
<p xml:id="subtitle682" begin="25955416667t" end="25972500000t" region="region0"><span style="style1">Is that the duke's helmet?</span></p>
<p xml:id="subtitle683" begin="26065833334t" end="26076666667t" region="region0"><span style="style1">[Jet sighs]</span></p>
<p xml:id="subtitle684" begin="26077500000t" end="26097500000t" region="region0"><span style="style1">[mysterious music playing]</span></p>
<p xml:id="subtitle685" begin="26113750000t" end="26132083334t" region="region0"><span style="style1">When the Fire Nation invaded,</span></p>
<p xml:id="subtitle686" begin="26149166667t" end="26170000000t" region="region0"><span style="style1">he was always the first one to volunteer.</span></p>
<p xml:id="subtitle687" begin="26195833334t" end="26233333334t" region="region0"><span style="style1">[sighs] He kept saying,</span><br/><span style="style1">&quot;I trained for this.&quot;</span></p>
<p xml:id="subtitle688" begin="26254583334t" end="26264583334t" region="region0"><span style="style1">We had.</span></p>
<p xml:id="subtitle689" begin="26277500000t" end="26286666667t" region="region0"><span style="style1">Kind of.</span></p>
<p xml:id="subtitle690" begin="26307916667t" end="26320000000t" region="region0"><span style="style1">We struck back.</span></p>
<p xml:id="subtitle691" begin="26330000000t" end="26340416667t" region="region0"><span style="style1">Insurgents.</span></p>
<p xml:id="subtitle692" begin="26345416667t" end="26364583334t" region="region0"><span style="style1">We knew every inch of the city,</span></p>
<p xml:id="subtitle693" begin="26365416667t" end="26395833334t" region="region0"><span style="style1">and we wouldn't let them move freely</span><br/><span style="style1">without feeling our sting.</span></p>
<p xml:id="subtitle694" begin="26445833334t" end="26456666667t" region="region0"><span style="style1">One day…</span></p>
<p xml:id="subtitle695" begin="26478750000t" end="26493750000t" region="region0"><span style="style1">they were ready for us.</span></p>
<p xml:id="subtitle696" begin="26563750000t" end="26595416667t" region="region0"><span style="style1">There was an ambush,</span><br/><span style="style1">and Pipsqueak and the Duke…</span></p>
<p xml:id="subtitle697" begin="26619583334t" end="26644166667t" region="region0"><span style="style1">I didn't see what happened to Pipsqueak,</span></p>
<p xml:id="subtitle698" begin="26649166667t" end="26658333334t" region="region0"><span style="style1">but…</span></p>
<p xml:id="subtitle699" begin="26683333334t" end="26691666667t" region="region0"><span style="style1">[sighs]</span></p>
<p xml:id="subtitle700" begin="26692500000t" end="26720000000t" region="region0"><span style="style1">…I picked up The Duke, and I ran.</span></p>
<p xml:id="subtitle701" begin="26752916667t" end="26799583334t" region="region0"><span style="style1">[voice breaking] I ran as far</span><br/><span style="style1">and as fast as I could.</span></p>
<p xml:id="subtitle702" begin="26869583334t" end="26895833334t" region="region0"><span style="style1">By the time I stopped to check him…</span></p>
<p xml:id="subtitle703" begin="26937916667t" end="26953750000t" region="region0"><span style="style1">he was already cold.</span></p>
<p xml:id="subtitle704" begin="26995416667t" end="27007916667t" region="region0"><span style="style1">We were kids</span></p>
<p xml:id="subtitle705" begin="27018333334t" end="27037083334t" region="region0"><span style="style1">playing at war.</span></p>
<p xml:id="subtitle706" begin="27050000000t" end="27070416667t" region="region0"><span style="style1">And then a real war came.</span></p>
<p xml:id="subtitle707" begin="27089166667t" end="27138750000t" region="region0"><span style="style1">Every single one of them</span><br/><span style="style1">would still be alive if they never met me.</span></p>
<p xml:id="subtitle708" begin="27139583334t" end="27155000000t" region="region0"><span style="style1">[panting]</span></p>
<p xml:id="subtitle709" begin="27155833334t" end="27172916667t" region="region0"><span style="style1">[Katara] It's not your fault.</span></p>
<p xml:id="subtitle710" begin="27186666667t" end="27205416667t" region="region0"><span style="style1">It's the Fire Nation's.</span></p>
<p xml:id="subtitle711" begin="27210833334t" end="27221666667t" region="region0"><span style="style1">And you know that.</span></p>
<p xml:id="subtitle712" begin="27241666667t" end="27254583334t" region="region0"><span style="style1">You did good.</span></p>
<p xml:id="subtitle713" begin="27255416667t" end="27275000000t" region="region0"><span style="style1">You taught them to stand up.</span></p>
<p xml:id="subtitle714" begin="27303333334t" end="27327500000t" region="region0"><span style="style1">They would love you for that, I'm sure.</span></p>
<p xml:id="subtitle715" begin="27372916667t" end="27393333334t" region="region0"><span style="style1">They're better off without me.</span></p>
<p xml:id="subtitle716" begin="27430833334t" end="27445000000t" region="region0"><span style="style1">Everyone is.</span></p>
<p xml:id="subtitle717" begin="27484583334t" end="27502083334t" region="region0"><span style="style1">[Toph] </span><span style="style2">We are in serious trouble.</span></p>
<p xml:id="subtitle718" begin="27502916667t" end="27522083334t" region="region0"><span style="style1">There's this comet coming,</span></p>
<p xml:id="subtitle719" begin="27522916667t" end="27552500000t" region="region0"><span style="style1">and it's supposed to</span><br/><span style="style1">supercharge the Firebenders.</span></p>
<p xml:id="subtitle720" begin="27553333334t" end="27574166667t" region="region0"><span style="style1">And we have to tell</span><br/><span style="style1">the Earth King about it.</span></p>
<p xml:id="subtitle721" begin="27575000000t" end="27606666667t" region="region0"><span style="style1">But we have no proof</span><br/><span style="style1">or any idea of when it's going to come.</span></p>
<p xml:id="subtitle722" begin="27607500000t" end="27615833334t" region="region0"><span style="style1">Yes, you do.</span></p>
<p xml:id="subtitle723" begin="27616666667t" end="27627500000t" region="region0"><span style="style1">No, I don't.</span></p>
<p xml:id="subtitle724" begin="27628333334t" end="27647083334t" region="region0"><span style="style1">You're holding the proof in your hands.</span></p>
<p xml:id="subtitle725" begin="27665833334t" end="27692500000t" region="region0"><span style="style1">The Great Comet came twice during my life.</span></p>
<p xml:id="subtitle726" begin="27693333334t" end="27741250000t" region="region0"><span style="style1">It does make Firebenders stronger,</span><br/><span style="style1">but it also made my firebending stronger.</span></p>
<p xml:id="subtitle727" begin="27749166667t" end="27769166667t" region="region0"><span style="style1">A strong Avatar can maintain balance.</span></p>
<p xml:id="subtitle728" begin="27786250000t" end="27814166667t" region="region0"><span style="style1">So you… you put it all in here?</span></p>
<p xml:id="subtitle729" begin="27815000000t" end="27823750000t" region="region0"><span style="style1">Yes.</span></p>
<p xml:id="subtitle730" begin="27833750000t" end="27859166667t" region="region0"><span style="style1">I tracked the orbital cycle of the comet.</span></p>
<p xml:id="subtitle731" begin="27860000000t" end="27884583334t" region="region0"><span style="style1">So its arrival</span><br/><span style="style1">should be simple to calculate.</span></p>
<p xml:id="subtitle732" begin="27889583334t" end="27925833334t" region="region0"><span style="style1">In fact, I tracked all periods when</span><br/><span style="style1">other elements were stronger or weaker.</span></p>
<p xml:id="subtitle733" begin="27940000000t" end="27953750000t" region="region0"><span style="style1">Wait, so,</span></p>
<p xml:id="subtitle734" begin="27969166667t" end="28006250000t" region="region0"><span style="style1">is there a time</span><br/><span style="style1">when Firebenders are weaker?</span></p>
<p xml:id="subtitle735" begin="28007083334t" end="28055416667t" region="region0"><span style="style1">Yes. During a solar eclipse,</span><br/><span style="style1">or as they call it, the Day of Black Sun.</span></p>
<p xml:id="subtitle736" begin="28056250000t" end="28065833334t" region="region0"><span style="style1">[Toph sighs]</span></p>
<p xml:id="subtitle737" begin="28066666667t" end="28093333334t" region="region0"><span style="style1">They lose their bending entirely.</span></p>
<p xml:id="subtitle738" begin="28100833334t" end="28135833334t" region="region0"><span style="style1">[gasps] That's it! I have to go! I…</span></p>
<p xml:id="subtitle739" begin="28157083334t" end="28175833334t" region="region0"><span style="style1">Sokka! Sokka!</span></p>
<p xml:id="subtitle740" begin="28176666667t" end="28194166667t" region="region0"><span style="style1">-Sokka, we got it!</span><br/><span style="style1">-[Sokka] What?</span></p>
<p xml:id="subtitle741" begin="28195000000t" end="28217083334t" region="region0"><span style="style1">We found the date of the comet</span><br/><span style="style1">in Kyoshi's diary.</span></p>
<p xml:id="subtitle742" begin="28217916667t" end="28246666667t" region="region0"><span style="style1">The Firebenders are supercharged</span><br/><span style="style1">by the comet, right?</span></p>
<p xml:id="subtitle743" begin="28247500000t" end="28280416667t" region="region0"><span style="style1">Well, they lose their bending entirely</span><br/><span style="style1">on the day of a solar eclipse.</span></p>
<p xml:id="subtitle744" begin="28281250000t" end="28294583334t" region="region0"><span style="style1">They'll be helpless.</span></p>
<p xml:id="subtitle745" begin="28295416667t" end="28315833334t" region="region0"><span style="style1">If there's an eclipse</span><br/><span style="style1">before the comet arrives--</span></p>
<p xml:id="subtitle746" begin="28316666667t" end="28333333334t" region="region0"><span style="style1">Then that's the day we attack.</span></p>
<p xml:id="subtitle747" begin="28361666667t" end="28395416667t" region="region0"><span style="style1">No way! This is the room</span><br/><span style="style1">where we can figure that out.</span></p>
<p xml:id="subtitle748" begin="28396250000t" end="28418750000t" region="region0"><span style="style1">It tracks the movement</span><br/><span style="style1">of everything in the sky.</span></p>
<p xml:id="subtitle749" begin="28419583334t" end="28446250000t" region="region0"><span style="style1">So if we test the dates</span><br/><span style="style1">before the comet arrives</span></p>
<p xml:id="subtitle750" begin="28447083334t" end="28485000000t" region="region0"><span style="style1">and there's an eclipse,</span><br/><span style="style1">we can kiss those ash-holes goodbye!</span></p>
<p xml:id="subtitle751" begin="28485833334t" end="28495000000t" region="region0"><span style="style1">Here!</span></p>
<p xml:id="subtitle752" begin="28522916667t" end="28534583334t" region="region0"><span style="style1">[Jet] Is this for real?</span></p>
<p xml:id="subtitle753" begin="28535416667t" end="28547916667t" region="region0"><span style="style1">[Katara] What do you mean?</span></p>
<p xml:id="subtitle754" begin="28548750000t" end="28560416667t" region="region0"><span style="style1">Today.</span></p>
<p xml:id="subtitle755" begin="28566666667t" end="28578333334t" region="region0"><span style="style1">Right now.</span></p>
<p xml:id="subtitle756" begin="28584166667t" end="28614166667t" region="region0"><span style="style1">We might actually find a way</span><br/><span style="style1">to beat the Fire Nation?</span></p>
<p xml:id="subtitle757" begin="28621666667t" end="28633750000t" region="region0"><span style="style1">We have a shot.</span></p>
<p xml:id="subtitle758" begin="28673333334t" end="28684583334t" region="region0"><span style="style1">Thanks to you.</span></p>
<p xml:id="subtitle759" begin="28706250000t" end="28720833334t" region="region0"><span style="style1">[dramatic music playing]</span></p>
<p xml:id="subtitle760" begin="28873333334t" end="28887083334t" region="region0"><span style="style1">[squeaks]</span></p>
<p xml:id="subtitle761" begin="28887916667t" end="28899583334t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle762" begin="28909583334t" end="28929583334t" region="region0"><span style="style1">[chittering]</span></p>
<p xml:id="subtitle763" begin="28949583334t" end="28967916667t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle764" begin="28968750000t" end="28988750000t" region="region0"><span style="style1">-[explosion]</span><br/><span style="style1">-[Appa grunting]</span></p>
<p xml:id="subtitle765" begin="28996250000t" end="29016250000t" region="region0"><span style="style1">[Momo chittering]</span></p>
<p xml:id="subtitle766" begin="29088333334t" end="29108333334t" region="region0"><span style="style1">[mysterious music playing]</span></p>
<p xml:id="subtitle767" begin="29733750000t" end="29749583334t" region="region0"><span style="style1">[Momo chittering]</span></p>
<p xml:id="subtitle768" begin="29750416667t" end="29765833334t" region="region0"><span style="style1">[Appa grunting]</span></p>
<p xml:id="subtitle769" begin="29936666667t" end="29946666667t" region="region0"><span style="style1">[Iroh] Zuko?</span></p>
<p xml:id="subtitle770" begin="30014583334t" end="30025833334t" region="region0"><span style="style1">I had him.</span></p>
<p xml:id="subtitle771" begin="30078333334t" end="30092083334t" region="region0"><span style="style1">But I couldn't do it.</span></p>
<p xml:id="subtitle772" begin="30138333334t" end="30147083334t" region="region0"><span style="style1">I've got you.</span></p>
<p xml:id="subtitle773" begin="30152083334t" end="30162916667t" region="region0"><span style="style1">I've got you.</span></p>
<p xml:id="subtitle774" begin="30234583334t" end="30259166667t" region="region0"><span style="style1">[Zei] Mr. Great Librarian?</span></p>
<p xml:id="subtitle775" begin="30260000000t" end="30272083334t" region="region0"><span style="style1">[Wan Shi Tong] Mmm.</span></p>
<p xml:id="subtitle776" begin="30272916667t" end="30294583334t" region="region0"><span style="style1">What is it, scholar?</span></p>
<p xml:id="subtitle777" begin="30295416667t" end="30308333334t" region="region0"><span style="style1">[Zei] I understand now.</span></p>
<p xml:id="subtitle778" begin="30316666667t" end="30340833334t" region="region0"><span style="style1">Why you took this place</span><br/><span style="style1">from the human world.</span></p>
<p xml:id="subtitle779" begin="30354166667t" end="30369583334t" region="region0"><span style="style1">We're infected with</span></p>
<p xml:id="subtitle780" begin="30382083334t" end="30394583334t" region="region0"><span style="style1">ignorance,</span></p>
<p xml:id="subtitle781" begin="30400000000t" end="30410416667t" region="region0"><span style="style1">greed,</span></p>
<p xml:id="subtitle782" begin="30415416667t" end="30427916667t" region="region0"><span style="style1">and power lust.</span></p>
<p xml:id="subtitle783" begin="30456666667t" end="30468750000t" region="region0"><span style="style1">So, um…</span></p>
<p xml:id="subtitle784" begin="30509583334t" end="30532500000t" region="region0"><span style="style1">that's why I have to inform you</span></p>
<p xml:id="subtitle785" begin="30544583334t" end="30565833334t" region="region0"><span style="style1">of a violation of the rules.</span></p>
<p xml:id="subtitle786" begin="30584583334t" end="30614583334t" region="region0"><span style="style1">[suspenseful music swells]</span></p>
<p xml:id="subtitle787" begin="30620416667t" end="30645833334t" region="region0"><span style="style1">-[Katara] How far out are we?</span><br/><span style="style1">-[Sokka] From today?</span></p>
<p xml:id="subtitle788" begin="30715833334t" end="30725000000t" region="region0"><span style="style1">Look.</span></p>
<p xml:id="subtitle789" begin="30731666667t" end="30744166667t" region="region0"><span style="style1">At what?</span></p>
<p xml:id="subtitle790" begin="30803333334t" end="30816250000t" region="region0"><span style="style1">The eclipse.</span></p>
<p xml:id="subtitle791" begin="30822083334t" end="30856666667t" region="region0"><span style="style1">I can't believe it! We have it!</span><br/><span style="style1">The Day of Black Sun! We know it!</span></p>
<p xml:id="subtitle792" begin="30857500000t" end="30870000000t" region="region0"><span style="style1">[chuckles]</span></p>
<p xml:id="subtitle793" begin="30870833334t" end="30904583334t" region="region0"><span style="style1">[Wan Shi Tong] I knew</span><br/><span style="style1">you couldn't be trusted.</span></p>
<p xml:id="subtitle794" begin="30912500000t" end="30939583334t" region="region0"><span style="style1">Wait, no. You don't understand.</span></p>
<p xml:id="subtitle795" begin="30945416667t" end="30975416667t" region="region0"><span style="style1">This isn't about hurting people.</span><br/><span style="style1">It's about saving lives.</span></p>
<p xml:id="subtitle796" begin="30976250000t" end="31006250000t" region="region0"><span style="style1">Saving your lives through war!</span></p>
<p xml:id="subtitle797" begin="31007083334t" end="31036250000t" region="region0"><span style="style1">Wait a minute. How did you even find out?</span></p>
<p xml:id="subtitle798" begin="31056250000t" end="31078750000t" region="region0"><span style="style1">[Wan Shi Tong] He informed me</span><br/><span style="style1">of your wrongdoing</span></p>
<p xml:id="subtitle799" begin="31079583334t" end="31122083334t" region="region0"><span style="style1">in exchange for access to this library</span><br/><span style="style1">for all eternity.</span></p>
<p xml:id="subtitle800" begin="31122916667t" end="31134583334t" region="region0"><span style="style1">[Aang] Professor?</span></p>
<p xml:id="subtitle801" begin="31140833334t" end="31152500000t" region="region0"><span style="style1">How could you?</span></p>
<p xml:id="subtitle802" begin="31153333334t" end="31170416667t" region="region0"><span style="style1">You broke your promise.</span></p>
<p xml:id="subtitle803" begin="31171250000t" end="31215416667t" region="region0"><span style="style1">Unfortunately, Professor,</span><br/><span style="style1">you may not enjoy eternity much.</span></p>
<p xml:id="subtitle804" begin="31216250000t" end="31227083334t" region="region0"><span style="style1">What?</span></p>
<p xml:id="subtitle805" begin="31227916667t" end="31258333334t" region="region0"><span style="style1">You used what you learned here</span><br/><span style="style1">to harm your friends.</span></p>
<p xml:id="subtitle806" begin="31259166667t" end="31287500000t" region="region0"><span style="style1">You'll be the first to pay the price!</span></p>
<p xml:id="subtitle807" begin="31297916667t" end="31312916667t" region="region0"><span style="style1">[screeches]</span></p>
<p xml:id="subtitle808" begin="31313750000t" end="31342500000t" region="region0"><span style="style1">No! I'm a scholar, like you!</span></p>
<p xml:id="subtitle809" begin="31366666667t" end="31380000000t" region="region0"><span style="style1">-Run!</span><br/><span style="style1">-Go!</span></p>
<p xml:id="subtitle810" begin="31386666667t" end="31412083334t" region="region0"><span style="style1">[tense music swells]</span></p>
<p xml:id="subtitle811" begin="31427916667t" end="31445000000t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle812" begin="31494166667t" end="31513750000t" region="region0"><span style="style1">[Appa groans]</span></p>
<p xml:id="subtitle813" begin="31514583334t" end="31532500000t" region="region0"><span style="style1">[tense music playing]</span></p>
<p xml:id="subtitle814" begin="31533333334t" end="31549166667t" region="region0"><span style="style1">[Appa groans]</span></p>
<p xml:id="subtitle815" begin="31568750000t" end="31582916667t" region="region0"><span style="style1">[Momo screams]</span></p>
<p xml:id="subtitle816" begin="31599583334t" end="31614583334t" region="region0"><span style="style1">[Appa squeals]</span></p>
<p xml:id="subtitle817" begin="31709166667t" end="31725416667t" region="region0"><span style="style1">Toph, go! We're right behind you!</span></p>
<p xml:id="subtitle818" begin="31793750000t" end="31812916667t" region="region0"><span style="style1">You will not elude me!</span></p>
<p xml:id="subtitle819" begin="31813750000t" end="31846666667t" region="region0"><span style="style1">Don't you see? We're just trying</span><br/><span style="style1">to protect the people that we love!</span></p>
<p xml:id="subtitle820" begin="31847500000t" end="31888333334t" region="region0"><span style="style1">And I am protecting what I love!</span></p>
<p xml:id="subtitle821" begin="31931250000t" end="31942500000t" region="region0"><span style="style1">No, no, no, no, no!</span></p>
<p xml:id="subtitle822" begin="31964166667t" end="31979166667t" region="region0"><span style="style1">No, no, no, no!</span></p>
<p xml:id="subtitle823" begin="31993333334t" end="32005000000t" region="region0"><span style="style1">No, come on!</span></p>
<p xml:id="subtitle824" begin="32034166667t" end="32044166667t" region="region0"><span style="style1">Okay!</span></p>
<p xml:id="subtitle825" begin="32062500000t" end="32070833334t" region="region0"><span style="style1">No!</span></p>
<p xml:id="subtitle826" begin="32082500000t" end="32104583334t" region="region0"><span style="style1">No! Come on!</span></p>
<p xml:id="subtitle827" begin="32121666667t" end="32136250000t" region="region0"><span style="style1">Stop sinking!</span></p>
<p xml:id="subtitle828" begin="32137083334t" end="32155416667t" region="region0"><span style="style1">[Appa grunting]</span></p>
<p xml:id="subtitle829" begin="32156250000t" end="32187083334t" region="region0"><span style="style1">Appa, help me! [grunts]</span></p>
<p xml:id="subtitle830" begin="32187916667t" end="32207916667t" region="region0"><span style="style1">[Appa grunting]</span></p>
<p xml:id="subtitle831" begin="32242500000t" end="32278750000t" region="region0"><span style="style1">[Toph grunts] Hey! Get away from him!</span></p>
<p xml:id="subtitle832" begin="32279583334t" end="32290833334t" region="region0"><span style="style1">[grunts]</span></p>
<p xml:id="subtitle833" begin="32300000000t" end="32322916667t" region="region0"><span style="style1">No! No! Got it!</span></p>
<p xml:id="subtitle834" begin="32377500000t" end="32385833334t" region="region0"><span style="style1">[grunts]</span></p>
<p xml:id="subtitle835" begin="32390833334t" end="32410833334t" region="region0"><span style="style1">[screeches]</span></p>
<p xml:id="subtitle836" begin="32429583334t" end="32440416667t" region="region0"><span style="style1">Come on!</span></p>
<p xml:id="subtitle837" begin="32462083334t" end="32474583334t" region="region0"><span style="style1">[Wan Shi Tong screeches]</span></p>
<p xml:id="subtitle838" begin="32479583334t" end="32494583334t" region="region0"><span style="style1">-What now?</span><br/><span style="style1">-I'll distract him.</span></p>
<p xml:id="subtitle839" begin="32495416667t" end="32515000000t" region="region0"><span style="style1">The rest of you, get past him and get out.</span></p>
<p xml:id="subtitle840" begin="32515833334t" end="32525000000t" region="region0"><span style="style1">No.</span></p>
<p xml:id="subtitle841" begin="32530416667t" end="32538750000t" region="region0"><span style="style1">I'll do it.</span></p>
<p xml:id="subtitle842" begin="32549166667t" end="32569166667t" region="region0"><span style="style1">You can't fight him.</span><br/><span style="style1">No, we'll figure it out.</span></p>
<p xml:id="subtitle843" begin="32570000000t" end="32588750000t" region="region0"><span style="style1">Katara, do me a favor.</span></p>
<p xml:id="subtitle844" begin="32645833334t" end="32663750000t" region="region0"><span style="style1">[wings flapping]</span></p>
<p xml:id="subtitle845" begin="32678750000t" end="32700416667t" region="region0"><span style="style1">[screeches]</span></p>
<p xml:id="subtitle846" begin="32701250000t" end="32715833334t" region="region0"><span style="style1">Kill them all.</span></p>
<p xml:id="subtitle847" begin="32748333334t" end="32762083334t" region="region0"><span style="style1">[Sokka] Katara, come on. Get up.</span></p>
<p xml:id="subtitle848" begin="32762916667t" end="32779583334t" region="region0"><span style="style1">Time to trim those feathers!</span></p>
<p xml:id="subtitle849" begin="32791666667t" end="32808333334t" region="region0"><span style="style1">[screeches]</span></p>
<p xml:id="subtitle850" begin="32809166667t" end="32823750000t" region="region0"><span style="style1">[dramatic music playing]</span></p>
<p xml:id="subtitle851" begin="32835416667t" end="32851666667t" region="region0"><span style="style1">[screeches]</span></p>
<p xml:id="subtitle852" begin="32944166667t" end="32959583334t" region="region0"><span style="style1">Heave off, insect!</span></p>
<p xml:id="subtitle853" begin="32960416667t" end="32969166667t" region="region0"><span style="style1">[Jet grunts]</span></p>
<p xml:id="subtitle854" begin="32975000000t" end="32987500000t" region="region0"><span style="style1">[gasps]</span></p>
<p xml:id="subtitle855" begin="33008750000t" end="33017500000t" region="region0"><span style="style1">[groans]</span></p>
<p xml:id="subtitle856" begin="33038750000t" end="33057500000t" region="region0"><span style="style1">[Appa groaning]</span></p>
<p xml:id="subtitle857" begin="33058333334t" end="33080000000t" region="region0"><span style="style1">Leave him alone!</span></p>
<p xml:id="subtitle858" begin="33093333334t" end="33104166667t" region="region0"><span style="style1">[grunts]</span></p>
<p xml:id="subtitle859" begin="33105000000t" end="33117083334t" region="region0"><span style="style1">No!</span></p>
<p xml:id="subtitle860" begin="33117916667t" end="33134583334t" region="region0"><span style="style1">[grunts]</span></p>
<p xml:id="subtitle861" begin="33142916667t" end="33162083334t" region="region0"><span style="style1">[Appa grunts]</span></p>
<p xml:id="subtitle862" begin="33162916667t" end="33172916667t" region="region0"><span style="style1">No!</span></p>
<p xml:id="subtitle863" begin="33208333334t" end="33225416667t" region="region0"><span style="style1">I'm sorry, Appa!</span></p>
<p xml:id="subtitle864" begin="33243750000t" end="33256666667t" region="region0"><span style="style1">[grunts]</span></p>
<p xml:id="subtitle865" begin="33257500000t" end="33277916667t" region="region0"><span style="style1">-[Appa groans]</span><br/><span style="style1">-[Toph grunts]</span></p>
<p xml:id="subtitle866" begin="33284166667t" end="33304166667t" region="region0"><span style="style1">[mysterious music playing]</span></p>
<p xml:id="subtitle867" begin="33332083334t" end="33347500000t" region="region0"><span style="style1">[screeching]</span></p>
<p xml:id="subtitle868" begin="33399583334t" end="33420833334t" region="region0"><span style="style1">[groaning]</span></p>
<p xml:id="subtitle869" begin="33463750000t" end="33476666667t" region="region0"><span style="style1">[grunts]</span></p>
<p xml:id="subtitle870" begin="33493333334t" end="33513333334t" region="region0"><span style="style1">[dramatic music playing]</span></p>
<p xml:id="subtitle871" begin="33526250000t" end="33541250000t" region="region0"><span style="style1">[screeching]</span></p>
<p xml:id="subtitle872" begin="33647083334t" end="33656250000t" region="region0"><span style="style1">[gasps]</span></p>
<p xml:id="subtitle873" begin="33666666667t" end="33680833334t" region="region0"><span style="style1">[screeching]</span></p>
<p xml:id="subtitle874" begin="33810833334t" end="33822500000t" region="region0"><span style="style1">[mystical whirring]</span></p>
<p xml:id="subtitle875" begin="33823333334t" end="33831666667t" region="region0"><span style="style1">[gasps]</span></p>
<p xml:id="subtitle876" begin="33832500000t" end="33843750000t" region="region0"><span style="style1">[Katara] Jet!</span></p>
<p xml:id="subtitle877" begin="33844583334t" end="33863333334t" region="region0"><span style="style1">Jet! We have to get him out somehow!</span></p>
<p xml:id="subtitle878" begin="33864166667t" end="33885000000t" region="region0"><span style="style1">-How?</span><br/><span style="style1">-I don't know how! We have to go back in!</span></p>
<p xml:id="subtitle879" begin="33885833334t" end="33900833334t" region="region0"><span style="style1">-How do we get him out?</span><br/><span style="style1">-No!</span></p>
<p xml:id="subtitle880" begin="33908333334t" end="33931666667t" region="region0"><span style="style1">No! No, he's gone.</span></p>
<p xml:id="subtitle881" begin="33932500000t" end="33962500000t" region="region0"><span style="style1">[somber music playing]</span></p>
<p xml:id="subtitle882" begin="34001666667t" end="34015000000t" region="region0"><span style="style1">He saved us all.</span></p>
<p xml:id="subtitle883" begin="34015833334t" end="34031666667t" region="region0"><span style="style1">[Katara breathing shakily]</span></p>
<p xml:id="subtitle884" begin="34036666667t" end="34047916667t" region="region0"><span style="style1">[gasps]</span></p>
<p xml:id="subtitle885" begin="34076666667t" end="34086250000t" region="region0"><span style="style1">Wait.</span></p>
<p xml:id="subtitle886" begin="34099166667t" end="34111666667t" region="region0"><span style="style1">Where's Appa?</span></p>
<p xml:id="subtitle887" begin="34134583334t" end="34147083334t" region="region0"><span style="style1">Appa?</span></p>
<p xml:id="subtitle888" begin="34158333334t" end="34170833334t" region="region0"><span style="style1">Where are you, buddy?</span></p>
<p xml:id="subtitle889" begin="34182500000t" end="34195833334t" region="region0"><span style="style1">Appa!</span></p>
<p xml:id="subtitle890" begin="34196666667t" end="34218750000t" region="region0"><span style="style1">[Momo whimpering]</span></p>
<p xml:id="subtitle891" begin="34219583334t" end="34232083334t" region="region0"><span style="style1">Momo?</span></p>
<p xml:id="subtitle892" begin="34250833334t" end="34262500000t" region="region0"><span style="style1">[Aang] Appa!</span></p>
<p xml:id="subtitle893" begin="34263333334t" end="34281666667t" region="region0"><span style="style1">-Aang.</span><br/><span style="style1">-[Aang] Toph, can you feel Appa?</span></p>
<p xml:id="subtitle894" begin="34282500000t" end="34309583334t" region="region0"><span style="style1">No! No, some people came,</span><br/><span style="style1">and they took him! I…</span></p>
<p xml:id="subtitle895" begin="34310416667t" end="34324583334t" region="region0"><span style="style1">Took him where?</span></p>
<p xml:id="subtitle896" begin="34325416667t" end="34360000000t" region="region0"><span style="style1">I don't know! I was… I was…</span><br/><span style="style1">Look, I tried to stop them!</span></p>
<p xml:id="subtitle897" begin="34360833334t" end="34380000000t" region="region0"><span style="style1">-[Sokka] Who took him? Aang?</span><br/><span style="style1">-[Toph] I don't know!</span></p>
<p xml:id="subtitle898" begin="34380833334t" end="34389583334t" region="region0"><span style="style1">Appa!</span></p>
<p xml:id="subtitle899" begin="34390416667t" end="34402083334t" region="region0"><span style="style1">Aang.</span></p>
<p xml:id="subtitle900" begin="34402916667t" end="34419166667t" region="region0"><span style="style1">[echoing] Appa!</span></p>
<p xml:id="subtitle901" begin="34420000000t" end="34439583334t" region="region0"><span style="style1">[dramatic music swells]</span></p>
<p xml:id="subtitle902" begin="34448333334t" end="34468333334t" region="region0"><span style="style1">[wind whistling]</span></p>
<p xml:id="subtitle903" begin="34487500000t" end="34506666667t" region="region0"><span style="style1">[adventurous music playing]</span></p>
<p xml:id="subtitle904" begin="35777500000t" end="35804583334t" region="region0"><span style="style1">[music fades]</span></p>
</div>
</body>
</tt>
